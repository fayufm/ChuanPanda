                <th>鍦扮�?/th>
                <th>鍙備笌鐔婄尗</th>
              </tr>
            </thead>
            <tbody>
    `;
    
    // 娣诲姞娲诲姩鏃堕棿琛ㄦ暟�?    liveData.scheduleData.forEach(schedule => {
      liveHtml += `
        <tr>
          <td>${schedule.time}</td>
          <td>${schedule.activity}</td>
          <td>${schedule.location}</td>
          <td>${schedule.pandas}</td>
        </tr>
      `;
    });
    
    // 鍏抽棴鏃堕棿琛ㄥ拰椤甸潰瀹瑰�?
    liveHtml += `
            </tbody>
          </table>
        </div>
      </div>
    `;
    
    // 鏇存柊鍐呭
    contentContainer.innerHTML = liveHtml;
    
    // 鍒濆鍖栬嚜鍔ㄥ埛鏂板姛�?    if (typeof autoRefresh !== 'undefined' && autoRefresh.initAutoRefresh) {
      const livePageContainer = document.querySelector('.live-page');
      if (livePageContainer) {
        autoRefresh.initAutoRefresh(livePageContainer, refreshLiveData, 60000); // �?0绉掑埛鏂颁竴�?      }
    }
    
    // 娣诲姞鏍囩椤靛垏鎹㈠姛�?    const tabButtons = document.querySelectorAll('.tab-btn');
    tabButtons.forEach(button => {
      button.addEventListener('click', function() {
        // 绉婚櫎鎵€鏈夋爣绛炬寜閽殑娲诲姩鐘讹拷?        tabButtons.forEach(btn => btn.classList.remove('active'));
        // 娣诲姞褰撳墠鏍囩鎸夐挳鐨勬椿鍔ㄧ姸�?        this.classList.add('active');
        
        // 鑾峰彇鐩爣鏍囩椤礗D
        const targetTabId = this.getAttribute('data-tab');
        
        // 闅愯棌鎵€鏈夋爣绛鹃〉鍐呭
        const tabPanes = document.querySelectorAll('.tab-pane');
        tabPanes.forEach(pane => pane.classList.remove('active'));
        
        // 鏄剧ず鐩爣鏍囩椤靛唴�?        document.getElementById(targetTabId).classList.add('active');
      });
    });
    
    // 娣诲姞鐩存挱鎸夐挳鐐瑰嚮浜嬩�?
    const playButtons = document.querySelectorAll('.play-button:not([disabled])');
    playButtons.forEach(button => {
      button.addEventListener('click', function() {
        const livePlayer = this.closest('.live-player');
        const placeholder = livePlayer.querySelector('.live-placeholder');
        const url = this.getAttribute('data-url');
        
        // 杩欓噷搴旇鏄疄闄呯殑瑙嗛鎾斁閫昏�?
        this.textContent = "姝ｅ湪鐩存挱�?..";
        this.disabled = true;
        placeholder.style.opacity = "0.7";
        
        // 娣诲姞涓€涓彁绀轰俊�?        const liveStatus = document.createElement('div');
        liveStatus.className = 'live-status';
        liveStatus.textContent = '鐩存挱杩炴帴涓紝璇风◢�?..';
        livePlayer.appendChild(liveStatus);
        
        // 灏濊瘯鎵撳紑鐩存挱閾炬帴
        window.open(url, '_blank');
      });
    });
    
    // 娣诲姞鍘嗗彶鍥炴斁鎸夐挳鐐瑰嚮浜嬩欢
    const historyPlayButtons = document.querySelectorAll('.history-play-btn');
    historyPlayButtons.forEach(button => {
      button.addEventListener('click', function() {
        const url = this.getAttribute('data-url');
        if (url && url !== '#') {
          window.open(url, '_blank');
        } else {
          alert('璇ュ巻鍙茶棰戞殏涓嶅彲�?);
        }
      });
    });
    
    // 绉婚櫎鏃х殑鐜鏁版嵁鑷姩鍒锋柊鍔熻兘锛屽洜涓哄凡缁忕敱autoRefresh妯″潡澶勭�?
    
  } catch (error) {
    console.error('鍔犺浇鐔婄尗鐩存挱澶辫触:', error);
    contentContainer.innerHTML = '<div class="error-container"><p>鍔犺浇鐔婄尗鐩存挱澶辫触锛岃绋嶅悗鍐嶈瘯锟?/p></div>';
  }
} 

// 鍔犺浇鐔婄尗鍦板浘椤甸潰
async function loadPandaMap() {
  const contentContainer = document.getElementById('content-container');
  
  // 鏄剧ず鍔犺浇鐘讹�?  contentContainer.innerHTML = '<div class="loading-container"><div class="loading-spinner"></div><p>姝ｅ湪鍔犺浇鐔婄尗鍦板浘...</p></div>';
  
  try {
    // 鑾峰彇API瀹炰�?
    const api = getAPI();
    if (!api) {
      throw new Error('API鏈嶅姟涓嶅彲�?);
    }
    
    // 鑾峰彇鐔婄尗浣嶇疆鏁版嵁
    let pandaLocations = [];
    
    // 灏濊瘯浠嶢PI鑾峰彇浣嶇疆鏁版�?
    try {
      if (api.getPandaLocations) {
        pandaLocations = await api.getPandaLocations();
      } else {
        // 濡傛灉API涓嶆敮鎸侊紝浣跨敤榛樿鏁版�?
        pandaLocations = getDefaultPandaLocations();
      }
    } catch (error) {
      console.warn('鑾峰彇鐔婄尗浣嶇疆鏁版嵁澶辫触锛屼娇鐢ㄩ粯璁ゆ暟�?, error);
      pandaLocations = getDefaultPandaLocations();
    }
    
    // 璁＄畻缁熻鏁版�?
    const totalPandas = pandaLocations.reduce((sum, loc) => sum + loc.count, 0);
    const wildPandas = pandaLocations
      .filter(loc => loc.type === 'wild')
      .reduce((sum, loc) => sum + loc.count, 0);
    const captivePandas = pandaLocations
      .filter(loc => loc.type === 'captive')
      .reduce((sum, loc) => sum + loc.count, 0);
    const researchPandas = pandaLocations
      .filter(loc => loc.type === 'research')
      .reduce((sum, loc) => sum + loc.count, 0);
    const countries = [...new Set(pandaLocations.map(loc => loc.country))].length;
    
    // 鏋勫缓鍦板浘HTML
    let mapHtml = `
      <div class="page-container map-page">
        <h2>鍏ㄧ悆鐔婄尗鍒嗗竷鍦板浘</h2>
        <div class="map-controls">
          <div class="map-filter">
            <label>绛涢€夋樉绀猴細</label>
            <select id="map-filter-select">
              <option value="all">鎵€鏈夌唺锟?/option>
              <option value="china">涓浗澶ч�?/option>
              <option value="international">鍥介檯鏈烘�?/option>
              <option value="wild">閲庣敓绉嶇兢</option>
              <option value="captive">鍦堝吇鐔婄尗</option>
              <option value="research">鐮旂┒涓績</option>
            </select>
            <button id="display-mode-btn" class="display-mode-btn">鍒囨崲瑙嗗浘妯″紡</button>
          </div>
          <div class="map-legend">
            <span class="legend-item"><span class="legend-dot wild"></span> 閲庣敓绉嶇兢</span>
            <span class="legend-item"><span class="legend-dot captive"></span> 鍦堝吇鐔婄尗</span>
            <span class="legend-item"><span class="legend-dot research"></span> 鐮旂┒涓績</span>
            <span class="legend-item"><span class="legend-dot multiple"></span> 澶氬姛鑳藉満鎵€</span>
          </div>
          <div class="map-filter-notice" style="display:none;"></div>
        </div>
        <div id="panda-map-container" class="panda-map-container"></div>
        <div class="map-info-panel">
          <h3>鐔婄尗鍒嗗竷淇℃�?/h3>
          <div id="map-info-content">
            <p>鐐瑰嚮鍦板浘涓婄殑鏍囪鏌ョ湅璇︾粏淇℃�?/p>
            <div class="map-stats">
              <div class="map-stat-item">
                <span class="map-stat-label">鍏ㄧ悆鐔婄尗鎬绘�?/span>
                <span class="map-stat-value">${totalPandas}�?/span>
              </div>
              <div class="map-stat-item">
                <span class="map-stat-label">閲庣敓鐔婄尗鏁伴�?/span>
                <span class="map-stat-value">${wildPandas}�?/span>
              </div>
              <div class="map-stat-item">
                <span class="map-stat-label">鍦堝吇鐔婄尗鏁伴�?/span>
                <span class="map-stat-value">${captivePandas}�?/span>
              </div>
              <div class="map-stat-item">
                <span class="map-stat-label">鐮旂┒涓績鐔婄�?/span>
                <span class="map-stat-value">${researchPandas}�?/span>
              </div>
              <div class="map-stat-item">
                <span class="map-stat-label">鍒嗗竷鍥藉/鍦板�?/span>
                <span class="map-stat-value">${countries}�?/span>
              </div>
              <div class="map-stat-item">
                <span class="map-stat-label">鍒嗗竷鐐逛綅鏁伴�?/span>
                <span class="map-stat-value">${pandaLocations.length}�?/span>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
    
    // 鏇存柊鍐呭
    contentContainer.innerHTML = mapHtml;
    
    // 鍒濆鍖栧湴�?    initPandaMap(pandaLocations);
    
    // 娣诲姞绛涢€変簨�?    const filterSelect = document.getElementById('map-filter-select');
    if (filterSelect) {
      filterSelect.addEventListener('change', function() {
        filterPandaLocations(this.value, pandaLocations);
      });
    }
    
  } catch (error) {
    console.error('鍔犺浇鐔婄尗鍦板浘澶辫触:', error);
    contentContainer.innerHTML = `
      <div class="error-container">
        <p>鍔犺浇鐔婄尗鍦板浘澶辫触锛岃绋嶅悗鍐嶈瘯锟?/p>
        <p class="error-details">${error.message}</p>
        <button id="retry-map" class="retry-button">閲嶈�?/button>
      </div>
    `;
    
    // 娣诲姞閲嶈瘯鎸夐挳鐐瑰嚮浜嬩�?
    const retryButton = document.getElementById('retry-map');
    if (retryButton) {
      retryButton.addEventListener('click', () => {
        loadPandaMap();
      });
    }
  }
}

// 鍒濆鍖栫唺鐚湴锟?function initPandaMap(locations) {
  // 妫€鏌ュ湴鍥惧�?  const mapContainer = document.getElementById('panda-map-container');
  if (!mapContainer) {
    console.error('鍦板浘瀹瑰櫒涓嶅瓨�?);
    return;
  }
  
  try {
    // 鍒涘缓瀹瑰櫒甯冨眬锛屽悓鏃跺寘鍚〃鏍煎拰鍦板�?
    let html = `
      <div style="display: flex; flex-direction: column; height: 100%;">
        <!-- 鍙嫋鎷藉湴鍥惧锟?-->
        <div id="draggable-map-container" class="draggable-map-container">
          <div class="map-instruction">
            <i class="fa fa-info-circle"></i> 榧犳爣鎷栨嫿鍙Щ鍔ㄥ湴鍥撅紝婊氳疆鍙缉鏀惧湴�?          </div>
          <div id="map-base" class="map-base" style="background-color: #e8f5f7;">
            <!-- 鑳屾櫙鍦板浘灏嗗湪杩欓噷缁樺�?-->
          </div>
          <div id="map-markers" class="map-markers">
            <!-- 鏍囪灏嗗湪杩欓噷娣诲姞 -->
          </div>
          <div class="map-legend-container">
            <span class="legend-item"><span class="legend-dot wild"></span> 閲庣敓绉嶇兢</span>
            <span class="legend-item"><span class="legend-dot captive"></span> 鍦堝吇鐔婄尗</span>
            <span class="legend-item"><span class="legend-dot research"></span> 鐮旂┒涓績</span>
          </div>
        </div>
        
        <!-- 浣嶇疆鍒楄�?-->
        <div class="locations-table-container">
          <h3 style="margin-top: 10px; margin-left: 10px;">鍏ㄧ悆鐔婄尗鍒嗗竷鍒楄�?/h3>
          <div style="margin-bottom: 20px; margin-left: 10px;">
            <div class="map-legend" style="display: flex; gap: 15px; margin-bottom: 15px;">
              <span class="legend-item"><span class="legend-dot wild" style="display:inline-block; width:12px; height:12px; border-radius:50%; background-color:#4CAF50;"></span> 閲庣敓绉嶇兢</span>
              <span class="legend-item"><span class="legend-dot captive" style="display:inline-block; width:12px; height:12px; border-radius:50%; background-color:#2196F3;"></span> 鍦堝吇鐔婄尗</span>
              <span class="legend-item"><span class="legend-dot research" style="display:inline-block; width:12px; height:12px; border-radius:50%; background-color:#9C27B0;"></span> 鐮旂┒涓績</span>
            </div>
          </div>
          
          <table style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
            <thead>
              <tr style="background-color: #f1f1f1;">
              <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">鍚嶇О</th>
              <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">鍥藉�?鍦板�?/th>
              <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">绫诲�?/th>
              <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">鐔婄尗鏁伴噺</th>
              <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">鍦板�?/th>
              <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">鎿嶄�?/th>
              </tr>
            </thead>
            <tbody>
    `;
    
    // 娣诲姞鐔婄尗浣嶇疆锟?    locations.forEach(loc => {
      // 纭畾绫诲瀷棰滆壊鍜屾爣锟?      let typeColor, typeLabel;
      if (loc.types && loc.types.length > 1) {
        typeColor = "#9467bd"; // 澶氬姛鑳藉満鎵€
        typeLabel = "澶氬姛鑳藉満鎵€";
      } else if (loc.type === 'wild') {
        typeColor = "#4CAF50"; // 閲庣�?
        typeLabel = "閲庣敓绉嶇兢";
      } else if (loc.type === 'captive') {
        typeColor = "#2196F3"; // 鍦堝�?
        typeLabel = "鍦堝吇鐔婄尗";
      } else {
        typeColor = "#9C27B0"; // 鐮旂┒涓績
        typeLabel = "鐮旂┒涓績";
      }
              
      html += `
                <tr class="location-row" data-id="${loc.id}" style="border-bottom: 1px solid #ddd; cursor: pointer;" 
                    onclick="selectLocation(${loc.id})">
          <td style="padding: 10px; border: 1px solid #ddd;"><strong>${loc.name}</strong></td>
          <td style="padding: 10px; border: 1px solid #ddd;">${loc.country}</td>
          <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">
                    <span style="display: inline-block; padding: 2px 8px; border-radius: 10px; background-color: ${typeColor}; color: white; font-size: 12px;">
                      ${typeLabel}
                    </span>
                  </td>
          <td style="padding: 10px; text-align: center; border: 1px solid #ddd;"><strong>${loc.count}</strong> �?/td>
          <td style="padding: 10px; border: 1px solid #ddd;">${loc.address}</td>
          <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">
                    <button class="view-detail-btn" onclick="event.stopPropagation(); selectLocation(${loc.id});"
                      style="background-color: #4ecdc4; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">
              鏌ョ湅璇︽儏
                    </button>
                  </td>
                </tr>
              `;
    });
    
    // 鍏抽棴琛ㄦ牸
    html += `
            </tbody>
          </table>
      </div>
      </div>
    `;
    
    // 灏咹TML娣诲姞鍒板�?    mapContainer.innerHTML = html;
    
    // 鍒濆鍖栧彲鎷栨嫿鍦板浘
    initDraggableMap();
    
    // 鍦ㄥ湴鍥句笂娣诲姞鏍囪
    addMarkersToMap(locations);
    
    // 娣诲姞鍏ㄥ眬閫夋嫨鍑芥暟
    window.selectLocation = function(locationId) {
      console.log('閫夋嫨浣嶇疆:', locationId);
      
      // 绉婚櫎鎵€鏈夎鐨勯€変腑鏍峰紡
      document.querySelectorAll('.location-row').forEach(row => {
        row.style.backgroundColor = '';
      });
      
      // 娣诲姞閫変腑琛岀殑鏍峰紡
      const selectedRow = document.querySelector(`.location-row[data-id="${locationId}"]`);
      if (selectedRow) {
        selectedRow.style.backgroundColor = '#e0f7fa';
      }
      
      // 鏌ユ壘骞舵樉绀轰綅缃俊锟?      const location = locations.find(loc => loc.id === locationId);
      if (location) {
        updateMapInfoPanel(location);
        
        // 鎵惧埌瀵瑰簲鐨勬爣璁板苟灞呬腑鏄剧�?
        const marker = document.querySelector(`.map-marker[data-id="${locationId}"]`);
        if (marker) {
          centerMapOnMarker(marker);
        }
      }
    };
    
    // 娣诲姞绛涢€夊姛鑳芥敮锟?    const filterSelect = document.getElementById('map-filter-select');
    if (filterSelect) {
      filterSelect.addEventListener('change', function() {
          const filter = this.value;
          
        document.querySelectorAll('.location-row').forEach(row => {
          const locationId = parseInt(row.dataset.id);
          const location = locations.find(loc => loc.id === locationId);
          
          if (!location) return;
          
            let shouldShow = true;
            
            if (filter === 'china') {
            shouldShow = location.country === '涓�?;
            } else if (filter === 'international') {
            shouldShow = location.country !== '涓�?;
            } else if (filter === 'wild') {
            shouldShow = location.type === 'wild' || (location.types && location.types.includes('wild'));
            } else if (filter === 'captive') {
            shouldShow = location.type === 'captive' || (location.types && location.types.includes('captive'));
            } else if (filter === 'research') {
            shouldShow = location.type === 'research' || (location.types && location.types.includes('research'));
            }
            
              row.style.display = shouldShow ? '' : 'none';
          });
          
          // 鏇存柊缁熻淇℃�?
          updateFilterStats(locations, filter);
          
          // 鏇存柊鍦板浘鏍囪�?
          updateMapMarkers(filter, locations);
      });
    }
    
    // 淇敼鏄剧ず妯″紡鍒囨崲鎸夐挳
    const displayModeBtn = document.getElementById('display-mode-btn');
    if (displayModeBtn) {
      displayModeBtn.textContent = '鍦板浘浼樺厛';
      displayModeBtn.addEventListener('click', function() {
        const mapContainer = document.getElementById('draggable-map-container');
        const tableContainer = document.querySelector('.locations-table-container');
        
        if (this.textContent === '鍦板浘浼樺厛') {
          // 鍒囨崲鍒板湴鍥句紭鍏堟ā锟?          mapContainer.style.height = '70%';
          tableContainer.style.height = '30%';
          this.textContent = '琛ㄦ牸浼樺厛';
    } else {
          // 鍒囨崲鍒拌〃鏍间紭鍏堟ā�?          mapContainer.style.height = '40%';
          tableContainer.style.height = '60%';
          this.textContent = '鍦板浘浼樺厛';
        }
      });
    }
    
    // 榛樿閫変腑绗竴涓綅�?    if (locations.length > 0) {
      setTimeout(() => {
        selectLocation(locations[0].id);
      }, 100);
    }
    
  } catch (error) {
    console.error('鍒涘缓鐔婄尗鍒嗗竷琛ㄦ牸澶辫�?', error);
    mapContainer.innerHTML = `
      <div class="map-error" style="padding: 20px; text-align: center;">
        <p>鏁版嵁鍔犺浇澶辫触锛岃绋嶅悗鍐嶈瘯�?/p>
        <p style="color: #f44336; font-size: 12px;">${error.message}</p>
      </div>
    `;
  }
}

// 鍦ㄥ湴鍥句笂娣诲姞鏍囪
function addMarkersToMap(locations) {
  const markersContainer = document.getElementById('map-markers');
  if (!markersContainer) return;
  
  // 娓呯┖鐜版湁鏍囪�?
  markersContainer.innerHTML = '';
  
  // 娣诲姞姣忎釜浣嶇疆鐨勬爣�?  locations.forEach(loc => {
    // 纭畾绫诲瀷鏍峰紡
    let typeClass;
    if (loc.types && loc.types.length > 1) {
      typeClass = 'multiple';
    } else {
      typeClass = loc.type;
    }
    
    // 鍒涘缓鏍囪鍏冪�?
    const marker = document.createElement('div');
    marker.className = `map-marker ${typeClass}`;
    marker.dataset.id = loc.id;
    marker.title = loc.name;
    
    // 璁剧疆鏍囪浣嶇疆锛堜娇鐢ㄧ櫨鍒嗘瘮浠ラ€傚簲涓嶅悓灞忓箷澶у皬锟?    // 灏嗙粡绾害鏄犲皠鍒板湴鍥句笂鐨勭浉瀵逛綅�?    const left = ((loc.longitude + 180) / 360) * 100;
    const top = ((90 - loc.latitude) / 180) * 100;
    marker.style.left = `${left}%`;
    marker.style.top = `${top}%`;
    
    // 濡傛灉鐔婄尗鏁伴噺瓒呰繃1锛屾坊鍔犳暟瀛楁爣锟?    if (loc.count > 1) {
      const countLabel = document.createElement('span');
      countLabel.className = 'marker-count';
      countLabel.textContent = loc.count;
      marker.appendChild(countLabel);
    }
    
    // 娣诲姞鐐瑰嚮浜嬩�?
    marker.addEventListener('click', () => {
      selectLocation(loc.id);
    });
    
    // 灏嗘爣璁版坊鍔犲埌瀹瑰�?
    markersContainer.appendChild(marker);
  });
  
  // 娣诲姞澶ч檰杞粨
  
}

// 娣诲姞澶ч檰杞粨
function addContinentOutlines() {
  const mapBase = document.getElementById('map-base');
  if (!mapBase) return;
  
  // 娓呴櫎涔嬪墠鐨勫唴锟?  mapBase.innerHTML = '';
  
  // 鏄剧ず鍔犺浇鐘讹�?  const loadingIndicator = document.createElement('div');
  loadingIndicator.className = 'loading-spinner';
  loadingIndicator.style.position = 'absolute';
  loadingIndicator.style.top = '50%';
  loadingIndicator.style.left = '50%';
  loadingIndicator.style.transform = 'translate(-50%, -50%)';
  
  const loadingText = document.createElement('div');
  loadingText.textContent = '姝ｅ湪鍔犺浇涓栫晫鍦板浘...';
  loadingText.style.position = 'absolute';
  loadingText.style.top = 'calc(50% + 40px)';
  loadingText.style.left = '50%';
  loadingText.style.transform = 'translateX(-50%)';
  loadingText.style.color = '#333';
  loadingText.style.fontWeight = 'bold';
  
  mapBase.appendChild(loadingIndicator);
  mapBase.appendChild(loadingText);
  
  // 鍔犺浇GeoJSON鏁版�?
  console.log('寮€濮嬪姞杞紾eoJSON鏁版�?..');
  fetch('assets/data/world.json')
    .then(response => {
      console.log('GeoJSON鏁版嵁鍝嶅簲鐘讹�?', response.status);
      if (!response.ok) {
        throw new Error('鏃犳硶鍔犺浇涓栫晫鍦板浘鏁版�?);
      }
      return response.json();
    })
    .then(geoData => {
      console.log('GeoJSON鏁版嵁鍔犺浇鎴愬姛锛屽紑濮嬪锟?..');
      // 绉婚櫎鍔犺浇鎸囩ず锟?      if (loadingIndicator.parentNode) loadingIndicator.parentNode.removeChild(loadingIndicator);
      if (loadingText.parentNode) loadingText.parentNode.removeChild(loadingText);
      
      // 鍒涘缓SVG鍏冪�?
      const svgNS = "http://www.w3.org/2000/svg";
      const svg = document.createElementNS(svgNS, "svg");
      svg.setAttribute("width", "100%");
      svg.setAttribute("height", "100%");
      svg.style.position = "absolute";
      svg.style.top = "0";
      svg.style.left = "0";
      
      // 娣诲姞娴锋磱鑳屾�?
      const ocean = document.createElementNS(svgNS, "rect");
      ocean.setAttribute("width", "100%");
      ocean.setAttribute("height", "100%");
      ocean.setAttribute("fill", "#cfe8f3");
      svg.appendChild(ocean);
      
      // 鍒涘缓鎶曞奖
      const mapWidth = mapBase.clientWidth || 900;
      const mapHeight = mapBase.clientHeight || 500;
      
      try {
        console.log('寮€濮嬪鐞咷eoJSON鏁版�?..');
        console.log('GeoJSON鏁版嵁瀵硅薄缁撴�?', Object.keys(geoData));
        
        // 鑾峰彇鍦扮悊鐗瑰�?
        let features;
        if (geoData.objects && geoData.objects.countries) {
          // TopoJSON鏍煎�?
          const countries = geoData.objects.countries;
          console.log('浣跨敤countries瀵硅�?);
          features = topojson.feature(geoData, countries).features;
        } else if (geoData.objects && geoData.objects.land) {
          // 鏈変簺TopoJSON浣跨敤land浣滀负瀵硅薄锟?          const land = geoData.objects.land;
          console.log('浣跨敤land瀵硅�?);
          features = topojson.feature(geoData, land).features;
        } else if (geoData.objects && Object.keys(geoData.objects).length > 0) {
          // 浣跨敤绗竴涓彲鐢ㄥ�?          const firstKey = Object.keys(geoData.objects)[0];
          console.log('浣跨敤绗竴涓彲鐢ㄥ�?', firstKey);
          features = topojson.feature(geoData, geoData.objects[firstKey]).features;
        } else if (geoData.features) {
          // 宸茬粡鏄疓eoJSON鏍煎�?
          console.log('鐩存帴浣跨敤GeoJSON features');
          features = geoData.features;
    } else {
          throw new Error('鏃犳硶璇嗗埆鐨勫湴鍥炬暟鎹牸锟?);
        }
        
        console.log('澶勭悊鍚庣殑鐗瑰緛鏁伴噺:', features.length);
        
        // 璁＄畻鍦板浘鐨勮竟鐣屾
        let bounds = {
          min: { x: Infinity, y: Infinity },
          max: { x: -Infinity, y: -Infinity }
        };
        
        features.forEach(feature => {
          if (!feature.geometry) return;
          
          const coords = feature.geometry.coordinates;
          if (!coords) return;
          
          if (feature.geometry.type === 'Polygon') {
            coords.forEach(ring => {
              ring.forEach(point => {
                bounds.min.x = Math.min(bounds.min.x, point[0]);
                bounds.min.y = Math.min(bounds.min.y, point[1]);
                bounds.max.x = Math.max(bounds.max.x, point[0]);
                bounds.max.y = Math.max(bounds.max.y, point[1]);
              });
            });
          } else if (feature.geometry.type === 'MultiPolygon') {
            coords.forEach(polygon => {
              polygon.forEach(ring => {
                ring.forEach(point => {
                  bounds.min.x = Math.min(bounds.min.x, point[0]);
                  bounds.min.y = Math.min(bounds.min.y, point[1]);
                  bounds.max.x = Math.max(bounds.max.x, point[0]);
                  bounds.max.y = Math.max(bounds.max.y, point[1]);
                });
              });
            });
          }
        });
        
        // 璁＄畻缂╂斁姣斾�?
        const xScale = mapWidth / (bounds.max.x - bounds.min.x);
        const yScale = mapHeight / (bounds.max.y - bounds.min.y);
        const scale = Math.min(xScale, yScale) * 0.9; // 鐣欎竴浜涜竟�?        
        // 璁＄畻骞崇Щ閲忥紝浣垮湴鍥惧眳�?        const xOffset = (mapWidth - (bounds.max.x - bounds.min.x) * scale) / 2;
        const yOffset = (mapHeight - (bounds.max.y - bounds.min.y) * scale) / 2;
        
        // 缁樺埗姣忎釜鍥藉�?鍦板�?
        features.forEach(feature => {
          if (!feature.geometry) return;
          
          const path = document.createElementNS(svgNS, "path");
          let d = "";
          
          if (feature.geometry.type === 'Polygon') {
            feature.geometry.coordinates.forEach(ring => {
              // 纭繚鐜笂鏈夎冻澶熺殑�?              if (ring.length < 3) return;
              
              // 寮€濮嬫柊鐨勫瓙璺�?
              const firstPoint = ring[0];
              const x0 = (firstPoint[0] - bounds.min.x) * scale + xOffset;
              // 鍙嶈浆Y杞存柟鍚戯紝浣垮寳鍗婄悆鍦ㄤ笂锟?              const y0 = mapHeight - ((firstPoint[1] - bounds.min.y) * scale + yOffset);
              d += `M${x0},${y0} `;
              
              // 娣诲姞鍏朵綑�?              for (let i = 1; i < ring.length; i++) {
                const point = ring[i];
                const x = (point[0] - bounds.min.x) * scale + xOffset;
                // 鍙嶈浆Y杞存柟鍚戯紝浣垮寳鍗婄悆鍦ㄤ笂锟?                const y = mapHeight - ((point[1] - bounds.min.y) * scale + yOffset);
                d += `L${x},${y} `;
              }
              
              // 闂悎璺緞
              d += "Z ";
            });
          } else if (feature.geometry.type === 'MultiPolygon') {
            feature.geometry.coordinates.forEach(polygon => {
              polygon.forEach(ring => {
                // 纭繚鐜笂鏈夎冻澶熺殑�?                if (ring.length < 3) return;
                
                // 寮€濮嬫柊鐨勫瓙璺�?
                const firstPoint = ring[0];
                const x0 = (firstPoint[0] - bounds.min.x) * scale + xOffset;
                // 鍙嶈浆Y杞存柟鍚戯紝浣垮寳鍗婄悆鍦ㄤ笂锟?                const y0 = mapHeight - ((firstPoint[1] - bounds.min.y) * scale + yOffset);
                d += `M${x0},${y0} `;
                
                // 娣诲姞鍏朵綑�?                for (let i = 1; i < ring.length; i++) {
                  const point = ring[i];
                  const x = (point[0] - bounds.min.x) * scale + xOffset;
                  // 鍙嶈浆Y杞存柟鍚戯紝浣垮寳鍗婄悆鍦ㄤ笂锟?                  const y = mapHeight - ((point[1] - bounds.min.y) * scale + yOffset);
                  d += `L${x},${y} `;
                }
                
                // 闂悎璺緞
                d += "Z ";
              });
            });
          }
          
          path.setAttribute("d", d);
          path.setAttribute("fill", "#e8e8e8");
          path.setAttribute("stroke", "#ccc");
          path.setAttribute("stroke-width", "0.5");
          path.setAttribute("class", "country");
          
          // 娣诲姞榧犳爣鎮仠鏁堟灉
          path.addEventListener('mouseover', () => {
            path.setAttribute("fill", "#d4d4d4");
          });
          
          path.addEventListener('mouseout', () => {
            path.setAttribute("fill", "#e8e8e8");
          });
          
          svg.appendChild(path);
        });
        
        mapBase.appendChild(svg);
        
        // 娣诲姞缁忕含搴︾綉鏍肩嚎
        addGridLines();
        
        // 娣诲姞鍦板浘娉ㄩ�?
        const mapNote = document.createElement('div');
        mapNote.className = 'map-note';
        mapNote.textContent = '涓栫晫鍦板浘 - 鍩轰簬鐪熷疄鍦扮悊鏁版嵁';
        mapNote.style.position = 'absolute';
        mapNote.style.bottom = '10px';
        mapNote.style.left = '50%';
        mapNote.style.transform = 'translateX(-50%)';
        mapNote.style.backgroundColor = 'rgba(255, 255, 255, 0.7)';
        mapNote.style.padding = '5px 10px';
        mapNote.style.borderRadius = '3px';
        mapNote.style.fontSize = '12px';
        mapNote.style.color = '#666';
        mapBase.appendChild(mapNote);
      } catch (error) {
        console.error('澶勭悊GeoJSON鏁版嵁鏃跺嚭�?', error);
        // 绉婚櫎鍔犺浇鎸囩ず锟?        if (loadingIndicator.parentNode) loadingIndicator.parentNode.removeChild(loadingIndicator);
        if (loadingText.parentNode) loadingText.parentNode.removeChild(loadingText);
        
        // 鍒涘缓澶囩敤绠€鍖栧湴锟?        createBackupMap();
      }
    })
    .catch(error => {
      console.error('鍔犺浇涓栫晫鍦板浘澶辫触:', error);
      // 绉婚櫎鍔犺浇鎸囩ず锟?      if (loadingIndicator.parentNode) loadingIndicator.parentNode.removeChild(loadingIndicator);
      if (loadingText.parentNode) loadingText.parentNode.removeChild(loadingText);
      
      // 鏄剧ず閿欒淇℃�?
      const errorText = document.createElement('div');
      errorText.textContent = '鍔犺浇涓栫晫鍦板浘澶辫触锛屾樉绀哄鐢ㄧ畝鍖栧湴鍥撅�?;
      errorText.style.position = 'absolute';
      errorText.style.top = '10px';
      errorText.style.left = '10px';
      errorText.style.color = '#f44336';
      errorText.style.backgroundColor = 'rgba(255, 255, 255, 0.7)';
      errorText.style.padding = '5px 10px';
      errorText.style.borderRadius = '3px';
      mapBase.appendChild(errorText);
      
      // 鍒涘缓澶囩敤绠€鍖栧湴锟?      createBackupMap();
    });
  
  // 澶囩敤鏂规锛氬垱寤虹畝鍖栫殑涓栫晫鍦板�?
  function createBackupMap() {
    // 鍒涘缓SVG鍏冪�?
    const svgNS = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(svgNS, "svg");
    svg.setAttribute("width", "100%");
    svg.setAttribute("height", "100%");
    svg.style.position = "absolute";
    svg.style.top = "0";
    svg.style.left = "0";
    
    // 娣诲姞娴锋磱鑳屾�?
    const ocean = document.createElementNS(svgNS, "rect");
    ocean.setAttribute("width", "100%");
    ocean.setAttribute("height", "100%");
    ocean.setAttribute("fill", "#cfe8f3");
    svg.appendChild(ocean);
    
    // 绠€鍖栫殑澶ч檰杞粨
    const continents = [
      { name: '浜氭�?, left: '60%', top: '30%', width: '25%', height: '35%' },
      { name: '鍖楃編锟?, left: '15%', top: '25%', width: '25%', height: '30%' },
      { name: '娆ф床', left: '45%', top: '20%', width: '15%', height: '25%' },
      { name: '闈炴�?, left: '45%', top: '45%', width: '20%', height: '35%' },
      { name: '鍗楃編锟?, left: '25%', top: '60%', width: '15%', height: '30%' },
      { name: '澶ф磱�?, left: '80%', top: '60%', width: '15%', height: '25%' }
    ];
    
    mapBase.appendChild(svg);
    
    // 鍒涘缓骞舵坊鍔犳瘡涓ぇ闄嗙殑鍏冪礌
    continents.forEach(continent => {
      const continentEl = document.createElement('div');
      continentEl.className = 'continent';
      continentEl.style.left = continent.left;
      continentEl.style.top = continent.top;
      continentEl.style.width = continent.width;
      continentEl.style.height = continent.height;
      continentEl.title = continent.name;
      mapBase.appendChild(continentEl);
    });
    
    // 娣诲姞鎻愮ず淇℃�?
    const mapNote = document.createElement('div');
    mapNote.className = 'map-note';
    mapNote.textContent = '鍔犺浇涓栫晫鍦板浘澶辫触锛屾樉绀哄鐢ㄧ畝鍖栧湴�?;
    mapNote.style.position = 'absolute';
    mapNote.style.bottom = '10px';
    mapNote.style.left = '0';
    mapNote.style.right = '0';
    mapNote.style.textAlign = 'center';
    mapNote.style.backgroundColor = 'rgba(255, 255, 255, 0.8)';
    mapNote.style.padding = '5px';
    mapNote.style.fontSize = '12px';
    mapNote.style.color = '#666';
    mapBase.appendChild(mapNote);
    
    // 娣诲姞缁忕含搴︾綉鏍肩嚎
    addGridLines();
  }
  
  // 娣诲姞缁忕含搴︾綉鏍肩嚎
  function addGridLines() {
    const gridContainer = document.createElement('div');
    gridContainer.className = 'grid-lines';
    gridContainer.style.position = 'absolute';
    gridContainer.style.top = '0';
    gridContainer.style.left = '0';
    gridContainer.style.width = '100%';
    gridContainer.style.height = '100%';
    gridContainer.style.pointerEvents = 'none';
    
    const svgNS = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(svgNS, "svg");
    svg.setAttribute("width", "100%");
    svg.setAttribute("height", "100%");
    svg.style.position = "absolute";
    svg.style.top = "0";
    svg.style.left = "0";
    svg.style.zIndex = "2";
    
    // 娣诲姞缁忕含搴︾綉鏍肩嚎
    const gridColor = "rgba(255, 255, 255, 0.3)";
    const gridWidth = "0.5";
    
    // 娣诲姞缁忓害�?    for (let i = 0; i <= 900; i += 100) {
      const longitudeLine = document.createElementNS(svgNS, "line");
      longitudeLine.setAttribute("x1", i);
      longitudeLine.setAttribute("y1", "0");
      longitudeLine.setAttribute("x2", i);
      longitudeLine.setAttribute("y2", "800");
      longitudeLine.setAttribute("stroke", gridColor);
      longitudeLine.setAttribute("stroke-width", gridWidth);
      svg.appendChild(longitudeLine);
    }
    
    // 娣诲姞绾害锟?    for (let i = 0; i <= 800; i += 100) {
      const latitudeLine = document.createElementNS(svgNS, "line");
      latitudeLine.setAttribute("x1", "0");
      latitudeLine.setAttribute("y1", i);
      latitudeLine.setAttribute("x2", "900");
      latitudeLine.setAttribute("y2", i);
      latitudeLine.setAttribute("stroke", gridColor);
      latitudeLine.setAttribute("stroke-width", gridWidth);
      svg.appendChild(latitudeLine);
    }
    
    gridContainer.appendChild(svg);
    mapBase.appendChild(gridContainer);
  }
}

// 鏇存柊鍦板浘鏍囪锛堟牴鎹瓫閫夋潯浠讹�?
function updateMapMarkers(filter, locations) {
  const markers = document.querySelectorAll('.map-marker');
  
  markers.forEach(marker => {
    const locationId = parseInt(marker.dataset.id);
    const location = locations.find(loc => loc.id === locationId);
    
    if (!location) return;
    
    let shouldShow = true;
    
    if (filter === 'china') {
      shouldShow = location.country === '涓�?;
    } else if (filter === 'international') {
      shouldShow = location.country !== '涓�?;
    } else if (filter === 'wild') {
      shouldShow = location.type === 'wild' || (location.types && location.types.includes('wild'));
    } else if (filter === 'captive') {
      shouldShow = location.type === 'captive' || (location.types && location.types.includes('captive'));
    } else if (filter === 'research') {
      shouldShow = location.type === 'research' || (location.types && location.types.includes('research'));
    }
    
    marker.style.display = shouldShow ? '' : 'none';
  });
}

// 鍒濆鍖栧彲鎷栨嫿鍦板浘
function initDraggableMap() {
  const draggableMap = document.getElementById('draggable-map-container');
  if (!draggableMap) return;
  
  // 鑾峰彇鍦板浘瀹瑰�?
  const mapBase = document.getElementById('map-base');
  const mapMarkers = document.getElementById('map-markers');
  
  // 瀛樺偍鍦板浘鐘讹�?  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let mapX = 0;
  let mapY = 0;
  let zoomLevel = 1;
  
  // 鏇存柊鍦板浘鍙樻�?
  function updateMapTransform() {
    if (mapBase && mapMarkers) {
      // 搴旂敤鍙樻崲鍒板湴鍥惧簳鍥惧拰鏍囪�?      const transform = `translate(${mapX}px, ${mapY}px) scale(${zoomLevel})`;
      mapBase.style.transform = transform;
      mapMarkers.style.transform = transform;
    }
  }
  
  // 娣诲姞榧犳爣浜嬩欢澶勭悊
  draggableMap.addEventListener('mousedown', (e) => {
    // 涓嶈澶勭悊鏍囪鐐瑰嚮浜嬩�?
    if (e.target.classList.contains('map-marker') || 
        e.target.parentElement.classList.contains('map-marker')) {
      return;
    }
    
    isDragging = true;
    startX = e.clientX - mapX;
    startY = e.clientY - mapY;
    draggableMap.style.cursor = 'grabbing';
  });
  
  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    
    mapX = e.clientX - startX;
    mapY = e.clientY - startY;
    updateMapTransform();
  });
  
  document.addEventListener('mouseup', () => {
    isDragging = false;
    draggableMap.style.cursor = 'grab';
  });
  
  // 娣诲姞缂╂斁鍔熻�?
  draggableMap.addEventListener('wheel', (e) => {
    e.preventDefault();
    
    // 纭畾榧犳爣浣嶇疆鐩稿浜庡湴鍥惧鍣ㄧ殑鍧愭爣
    const rect = draggableMap.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const mouseY = e.clientY - rect.top;
    
    // 璁＄畻榧犳爣鍦ㄥ綋鍓嶅彉鎹笅鐨勫湴鍥惧潗锟?    const mapMouseX = (mouseX - mapX) / zoomLevel;
    const mapMouseY = (mouseY - mapY) / zoomLevel;
    
    // 鏍规嵁婊氳疆鏂瑰悜璋冩暣缂╂斁绾у�?
    const zoomDelta = e.deltaY > 0 ? -0.1 : 0.1;
    const newZoomLevel = Math.max(0.5, Math.min(3, zoomLevel + zoomDelta));
    
    // 鍙湁鍦ㄧ缉鏀剧骇鍒敼鍙樻椂鎵嶉噸鏂拌绠椾綅锟?    if (newZoomLevel !== zoomLevel) {
      // 璋冩暣缂╂斁绾у埆
      zoomLevel = newZoomLevel;
      
      // 閲嶆柊璁＄畻鍦板浘鍋忕Щ锛屼繚鎸侀紶鏍囨寚鍚戠殑鍦板浘鐐逛笉�?      mapX = mouseX - mapMouseX * zoomLevel;
      mapY = mouseY - mapMouseY * zoomLevel;
      
      // 鏇存柊鍙樻崲
      updateMapTransform();
    }
  });
  
  // 娣诲姞瑙︽懜灞忔敮锟?  let touchStartX = 0;
  let touchStartY = 0;
  let initialDistance = 0;
  
  draggableMap.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
      // 鍗曟寚瑙︽懜 - 绉诲姩鍦板浘
      touchStartX = e.touches[0].clientX - mapX;
      touchStartY = e.touches[0].clientY - mapY;
    } else if (e.touches.length === 2) {
      // 鍙屾寚瑙︽懜 - 缂╂斁鍦板浘
      const touch1 = e.touches[0];
      const touch2 = e.touches[1];
      initialDistance = Math.hypot(
        touch2.clientX - touch1.clientX,
        touch2.clientY - touch1.clientY
      );
    }
  });
  
  draggableMap.addEventListener('touchmove', (e) => {
    e.preventDefault();
    
    if (e.touches.length === 1) {
      // 鍗曟寚绉诲姩鍦板�?
      mapX = e.touches[0].clientX - touchStartX;
      mapY = e.touches[0].clientY - touchStartY;
      updateMapTransform();
    } else if (e.touches.length === 2) {
      // 鍙屾寚缂╂斁
      const touch1 = e.touches[0];
      const touch2 = e.touches[1];
      const currentDistance = Math.hypot(
        touch2.clientX - touch1.clientX,
        touch2.clientY - touch1.clientY
      );
      
      // 璁＄畻涓績�?      const centerX = (touch1.clientX + touch2.clientX) / 2;
      const centerY = (touch1.clientY + touch2.clientY) / 2;
      
      // 鑾峰彇鍦板浘瀹瑰櫒浣嶇疆
      const rect = draggableMap.getBoundingClientRect();
      const containerCenterX = centerX - rect.left;
      const containerCenterY = centerY - rect.top;
      
      // 璁＄畻涓績鐐瑰湪褰撳墠鍙樻崲涓嬬殑鍦板浘鍧愭爣
      const mapCenterX = (containerCenterX - mapX) / zoomLevel;
      const mapCenterY = (containerCenterY - mapY) / zoomLevel;
      
      // 璁＄畻鏂扮殑缂╂斁绾у�?
      if (initialDistance > 0) {
        const newZoomLevel = Math.max(0.5, Math.min(3, zoomLevel * (currentDistance / initialDistance)));
        
        // 鍙湁鍦ㄧ缉鏀剧骇鍒樉钁楀彉鍖栨椂鎵嶉噸鏂拌绠椾綅锟?        if (Math.abs(newZoomLevel - zoomLevel) > 0.01) {
          zoomLevel = newZoomLevel;
          
          // 閲嶆柊璁＄畻鍦板浘鍋忕Щ锛屼繚鎸佷腑蹇冪偣涓嶅�?
          mapX = containerCenterX - mapCenterX * zoomLevel;
          mapY = containerCenterY - mapCenterY * zoomLevel;
          
          // 鏇存柊鍒濆璺濈�?
          initialDistance = currentDistance;
          
          // 鏇存柊鍙樻崲
          updateMapTransform();
        }
      }
    }
  });
  
  // 娣诲姞閿洏鎺у埗
  document.addEventListener('keydown', (e) => {
    // 鑾峰彇鍦板浘瀹瑰櫒鏄惁澶勪簬娲诲姩鐘讹�?    const isMapActive = document.activeElement === document.body && 
                       draggableMap.contains(document.activeElement) ||
                       draggableMap.matches(':hover');
    
    if (!isMapActive) return;
    
    // 璁＄畻绉诲姩閫熷�?
    const moveAmount = 20 / zoomLevel;
    
    // 鏂瑰悜閿帶�?    switch (e.key) {
      case 'ArrowUp':
        mapY += moveAmount;
        updateMapTransform();
        e.preventDefault();
        break;
      case 'ArrowDown':
        mapY -= moveAmount;
        updateMapTransform();
        e.preventDefault();
        break;
      case 'ArrowLeft':
        mapX += moveAmount;
        updateMapTransform();
        e.preventDefault();
        break;
      case 'ArrowRight':
        mapX -= moveAmount;
        updateMapTransform();
        e.preventDefault();
        break;
      case '+':
      case '=':
        zoomLevel = Math.min(3, zoomLevel + 0.1);
        updateMapTransform();
        e.preventDefault();
        break;
      case '-':
        zoomLevel = Math.max(0.5, zoomLevel - 0.1);
        updateMapTransform();
        e.preventDefault();
        break;
      case '0':
        // 閲嶇疆瑙嗗浘
        mapX = 0;
        mapY = 0;
        zoomLevel = 1;
        updateMapTransform();
        e.preventDefault();
        break;
    }
  });
  
  // 璁剧疆鍦板浘榛樿鏍峰紡鍜屽垵濮嬭�?  draggableMap.style.cursor = 'grab';
  mapBase.style.transformOrigin = '0 0';
  mapMarkers.style.transformOrigin = '0 0';
  
  // 鍒濆鍖栧湴鍥句綅缃紙灞呬腑锟?  const rect = draggableMap.getBoundingClientRect();
  mapX = rect.width / 4;
  updateMapTransform();
}
  
// 灏嗗湴鍥句腑蹇冭皟鏁村埌鐗瑰畾鏍囪
function centerMapOnMarker(marker) {
  if (!marker) return;
  
  // 鑾峰彇鍦板浘瀹瑰櫒鍜屾爣璁板锟?  const mapContainer = document.getElementById('draggable-map-container');
  const mapBase = document.getElementById('map-base');
  const mapMarkers = document.getElementById('map-markers');
  
  if (!mapContainer || !mapBase || !mapMarkers) return;
  
  // 鑾峰彇褰撳墠鍙樻崲淇℃伅
  const transform = mapBase.style.transform;
  const match = transform.match(/translate\((.+?)px,\s*(.+?)px\)\s*scale\((.+?)\)/);
  
  if (!match) return;
  
  const currentX = parseFloat(match[1]);
  const currentY = parseFloat(match[2]);
  const currentZoom = parseFloat(match[3]);
  
  // 鑾峰彇瀹瑰櫒鍜屾爣璁扮殑浣嶇疆鍜屽昂锟?  const containerRect = mapContainer.getBoundingClientRect();
  const markerRect = marker.getBoundingClientRect();
  
  // 璁＄畻鏍囪鍦ㄥ彉鎹㈠墠鐨勫師濮嬩綅�?  const markerStyle = getComputedStyle(marker);
  const originalLeft = parseFloat(markerStyle.left) / 100 * containerRect.width;
  const originalTop = parseFloat(markerStyle.top) / 100 * containerRect.height;
  
  // 璁＄畻鏂扮殑浣嶇疆锛堜娇鏍囪浣嶄簬瀹瑰櫒涓績�?  const targetX = containerRect.width / 2 - originalLeft * currentZoom;
  const targetY = containerRect.height / 2 - originalTop * currentZoom;
  
  // 骞虫粦杩囨浮鍒版柊浣嶇疆
  mapBase.style.transition = 'transform 0.5s ease-out';
  mapMarkers.style.transition = 'transform 0.5s ease-out';
  
  mapBase.style.transform = `translate(${targetX}px, ${targetY}px) scale(${currentZoom})`;
  mapMarkers.style.transform = `translate(${targetX}px, ${targetY}px) scale(${currentZoom})`;
  
  // 杩囨浮缁撴潫鍚庢竻闄よ繃娓″睘�?  setTimeout(() => {
    mapBase.style.transition = '';
    mapMarkers.style.transition = '';
  }, 500);
}
  
// 鏇存柊鍦板浘淇℃伅闈㈡澘锛屾樉绀洪€変腑鐨勬爣璁颁俊�?function updateMapInfoPanel(location) {
  const infoPanel = document.getElementById('map-info-content');
  if (!infoPanel) return;
  
  // 纭畾绫诲瀷鏂囨湰鍜屾牱锟?  let typeClass, typeText;
  if (location.types && location.types.length > 1) {
    typeClass = 'multiple';
    typeText = '澶氬姛鑳藉満鎵€';
  } else if (location.type === 'wild') {
    typeClass = 'wild';
    typeText = '閲庣敓绉嶇兢';
  } else if (location.type === 'captive') {
    typeClass = 'captive';
    typeText = '鍦堝吇鐔婄尗';
  } else {
    typeClass = 'research';
    typeText = '鐮旂┒涓績';
  }
  
  // 鏋勫缓HTML
  const html = `
    <h4>${location.name}</h4>
    <div class="type-badge ${typeClass}">${typeText}</div>
    <div class="map-info-address">
      <strong>鍦板潃锟?/strong>${location.address || '鏆傛棤璇︾粏鍦板�?}
    </div>
    <div class="map-info-details">
      <div class="map-info-item">
        <span class="map-info-label">鎵€鍦ㄥ浗锟?鍦板�?/span>
        <span class="map-info-value">${location.country}</span>
      </div>
      <div class="map-info-item">
        <span class="map-info-label">鐔婄尗鏁伴噺</span>
        <span class="map-info-value">${location.count} �?/span>
      </div>
        <div class="map-info-item">
        <span class="map-info-label">寤虹珛鏃堕棿</span>
        <span class="map-info-value">${location.established || '鏈�?}</span>
        </div>
      <div class="map-info-item">
        <span class="map-info-label">寮€鏀剧姸�?/span>
        <span class="map-info-value">${location.openStatus || '鏈�?}</span>
      </div>
    </div>
    <div class="map-info-description">
      <p>${location.description || '鏆傛棤璇︾粏鎻忚堪淇℃伅'}</p>
    </div>
  `;
  
  infoPanel.innerHTML = html;
}

// 绛涢€夌唺鐚綅�?(Leaflet鐗堟�?
function filterPandaLocations(filter, locations) {
  const mapContainer = document.getElementById('panda-map-container');
  if (!mapContainer) return;
  
  // 鑾峰彇鍦板浘瀹炰�?
  let map = null;
  // 鏌ユ壘鎵€鏈夊湴鍥惧疄锟?  for (const key in L) {
    if (L[key] && L[key]._container === mapContainer) {
      map = L[key];
      break;
    }
  }
  
  if (!map) return;
  
  // 鏇存柊绛涢€夋寜閽牱锟?  const filterSelect = document.getElementById('map-filter-select');
  if (filterSelect) {
    // 娣诲姞閫夋嫨鍔ㄧ敾鏁堟灉
    filterSelect.classList.add('active');
    setTimeout(() => {
      filterSelect.classList.remove('active');
    }, 500);
  }
  
  // 鏍规嵁绛涢€夋潯浠惰繃婊や綅�?  let filteredLocations = [];
  let filterName = '';
  
  switch (filter) {
    case 'china':
      filteredLocations = locations.filter(loc => loc.country === '涓�?);
      filterName = '涓浗澶ч�?;
      break;
    case 'international':
      filteredLocations = locations.filter(loc => loc.country !== '涓�?);
      filterName = '鍥介檯鏈烘�?;
      break;
    case 'wild':
      filteredLocations = locations.filter(loc => {
        return (loc.types && loc.types.includes('wild')) || loc.type === 'wild';
      });
      filterName = '閲庣敓绉嶇兢';
      break;
    case 'captive':
      filteredLocations = locations.filter(loc => {
        return (loc.types && loc.types.includes('captive')) || loc.type === 'captive';
      });
      filterName = '鍦堝吇鐔婄尗';
      break;
    case 'research':
      filteredLocations = locations.filter(loc => {
        return (loc.types && loc.types.includes('research')) || loc.type === 'research';
      });
      filterName = '鐮旂┒涓績';
      break;
    default:
      filteredLocations = locations;
      filterName = '鎵€鏈夌唺锟?;
  }
  
  // 娣诲姞杩囨浮鍔ㄧ�?
  const fadeOutMarkers = () => {
    // 鎵惧埌鎵€鏈夋爣�?    const markers = document.querySelectorAll('.leaflet-marker-icon, .leaflet-marker-shadow');
    
    // 娣诲姞娣″嚭鏁堟�?
    markers.forEach(marker => {
      marker.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      marker.style.opacity = '0';
      marker.style.transform = 'scale(0.8)';
    });
    
    // 鏄剧ず鍔犺浇鍔ㄧ�?
    const loadingElement = document.createElement('div');
    loadingElement.className = 'map-loading';
    loadingElement.style.opacity = '0';
    loadingElement.innerHTML = '<div class="map-loading-spinner"></div>';
    mapContainer.appendChild(loadingElement);
    
    // 娣″叆鍔犺浇鍔ㄧ敾
    setTimeout(() => {
      loadingElement.style.transition = 'opacity 0.3s ease';
      loadingElement.style.opacity = '1';
    }, 10);
    
    // 寤惰繜鍚庢竻闄ょ幇鏈夋爣璁帮紝淇濈暀搴曞浘鍥惧眰
    setTimeout(() => {
      map.eachLayer(function(layer) {
        // 淇濈暀搴曞浘鍥惧眰(TileLayer)锛岀Щ闄ゆ墍鏈夊叾浠栧浘锟?        if (!(layer instanceof L.TileLayer)) {
          map.removeLayer(layer);
        }
      });
      
      // 閲嶆柊娣诲姞搴曞�?
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);
      
      // 娣诲姞杩囨护鍚庣殑鏍囪
      addPandaMarkersLeaflet(map, filteredLocations);
      
      // 娣″嚭鍔犺浇鍔ㄧ敾
      setTimeout(() => {
        loadingElement.style.opacity = '0';
        // 绉婚櫎鍔犺浇鍔ㄧ�?
        setTimeout(() => {
          if (mapContainer.contains(loadingElement)) {
            mapContainer.removeChild(loadingElement);
          }
        }, 300);
      }, 500);
    }, 300);
  };
  
  // 鎵ц娣″嚭鍔ㄧ�?
  fadeOutMarkers();
  
  // 鏄剧ず绛涢€夋彁�?  const filterNotice = document.createElement('div');
  filterNotice.className = 'map-filter-notice';
  filterNotice.textContent = `宸茬瓫锟? ${filterName}`;
  filterNotice.style.position = 'absolute';
  filterNotice.style.bottom = '10px';
  filterNotice.style.right = '10px';
  filterNotice.style.background = 'rgba(0, 0, 0, 0.7)';
  filterNotice.style.color = 'white';
  filterNotice.style.padding = '8px 15px';
  filterNotice.style.borderRadius = '4px';
  filterNotice.style.fontSize = '14px';
  filterNotice.style.zIndex = '1000';
  filterNotice.style.opacity = '0';
  filterNotice.style.transition = 'opacity 0.3s ease';
  
  mapContainer.appendChild(filterNotice);
  
  // 鏄剧ず閫氱煡
  setTimeout(() => {
    filterNotice.style.opacity = '1';
    
    // 寤惰繜鍚庨殣钘忛€氱�?
    setTimeout(() => {
      filterNotice.style.opacity = '0';
      
      // 绉婚櫎閫氱煡鍏冪�?
      setTimeout(() => {
        if (mapContainer.contains(filterNotice)) {
          mapContainer.removeChild(filterNotice);
        }
      }, 300);
    }, 2000);
  }, 800);
  
  // 鏇存柊缁熻鏁版嵁鏄剧ず
  updateFilterStats(filteredLocations, filter);
}

// 鏇存柊绛涢€夊悗鐨勭粺璁℃暟�?function updateFilterStats(locations, filter) {
  const mapInfoContent = document.getElementById('map-info-content');
  if (!mapInfoContent) return;
  
  // 璁＄畻缁熻鏁版�?
  const totalPandas = locations.reduce((sum, loc) => sum + loc.count, 0);
  const wildPandas = locations
    .filter(loc => loc.type === 'wild')
    .reduce((sum, loc) => sum + loc.count, 0);
  const captivePandas = locations
    .filter(loc => loc.type === 'captive')
    .reduce((sum, loc) => sum + loc.count, 0);
  const researchPandas = locations
    .filter(loc => loc.type === 'research')
    .reduce((sum, loc) => sum + loc.count, 0);
  const countries = [...new Set(locations.map(loc => loc.country))].length;
  
  // 鑾峰彇绛涢€夊悕�?  let filterName = '';
  switch (filter) {
    case 'china': filterName = '涓浗澶ч�?; break;
    case 'international': filterName = '鍥介檯鏈烘�?; break;
    case 'wild': filterName = '閲庣敓绉嶇兢'; break;
    case 'captive': filterName = '鍦堝吇鐔婄尗'; break;
    case 'research': filterName = '鐮旂┒涓績'; break;
    default: filterName = '鎵€鏈夌唺锟?;
  }
  
  // 濡傛灉娌℃湁閫変腑鐗瑰畾鐔婄尗锛屾樉绀洪粯璁ゆ彁锟?  if (!mapInfoContent.querySelector('h4') || mapInfoContent.querySelector('h4').textContent === '鐔婄尗鍒嗗竷淇℃�?) {
    mapInfoContent.innerHTML = `
      <p>褰撳墠绛涳拷? <strong>${filterName}</strong></p>
      <p>鐐瑰嚮鍦板浘涓婄殑鏍囪鏌ョ湅璇︾粏淇℃�?/p>
      <div class="map-stats">
        <div class="map-stat-item">
          <span class="map-stat-label">鐔婄尗鎬绘暟</span>
          <span class="map-stat-value">${totalPandas}�?/span>
        </div>
        <div class="map-stat-item">
          <span class="map-stat-label">閲庣敓鐔婄尗</span>
          <span class="map-stat-value">${wildPandas}�?/span>
        </div>
        <div class="map-stat-item">
          <span class="map-stat-label">鍦堝吇鐔婄尗</span>
          <span class="map-stat-value">${captivePandas}�?/span>
        </div>
        <div class="map-stat-item">
          <span class="map-stat-label">鐮旂┒涓績鐔婄�?/span>
          <span class="map-stat-value">${researchPandas}�?/span>
        </div>
        <div class="map-stat-item">
          <span class="map-stat-label">鍒嗗竷鍥藉/鍦板�?/span>
          <span class="map-stat-value">${countries}�?/span>
        </div>
        <div class="map-stat-item">
          <span class="map-stat-label">鍒嗗竷鐐逛綅鏁伴�?/span>
          <span class="map-stat-value">${locations.length}�?/span>
        </div>
      </div>
    `;
    
    // 娣诲姞缁熻椤圭洰鍔ㄧ敾
    setTimeout(() => {
      const statItems = mapInfoContent.querySelectorAll('.map-stat-item');
      statItems.forEach((item, index) => {
        item.style.opacity = '0';
        item.style.transform = 'translateY(10px)';
        item.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        
        setTimeout(() => {
          item.style.opacity = '1';
          item.style.transform = 'translateY(0)';
        }, index * 100);
      });
    }, 100);
  }
}

