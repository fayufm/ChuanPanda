// 鍒囨崲鏍囪鏄剧ず妯″紡
function toggleMarkerDisplay(locations) {
  // 鑾峰彇褰撳墠妯″紡骞跺垏锟?  const currentMode = localStorage.getItem('useSimpleMarkers') === 'true';
  localStorage.setItem('useSimpleMarkers', (!currentMode).toString());
  
  // 鏇存柊鏄剧ず妯″紡鎸夐挳鏂囨湰鍜屾牱锟?  const displayModeBtn = document.getElementById('display-mode-btn');
  if (displayModeBtn) {
    displayModeBtn.textContent = !currentMode ? '浣跨敤鍥炬爣鏄剧�? : '浣跨敤鍦嗙偣鏄剧�?;
    
    // 娣诲姞鎸夐挳鍔ㄧ敾鏁堟灉
    displayModeBtn.classList.add('active');
    setTimeout(() => {
      displayModeBtn.classList.remove('active');
    }, 500);
  }
  
  // 鑾峰彇鍦板浘瀹炰�?
  const mapContainer = document.getElementById('panda-map-container');
  if (!mapContainer) {
    console.error('鎵句笉鍒板湴鍥惧锟?);
    return;
  }
  
  // 纭繚Leaflet宸插姞锟?  if (typeof L === 'undefined') {
    console.error('Leaflet鏈姞锟?);
    return;
  }
  
  let map = null;
  // 鏌ユ壘鎵€鏈夊湴鍥惧疄锟?  for (const key in L) {
    if (L[key] && L[key]._container === mapContainer) {
      map = L[key];
      break;
    }
  }
  
  if (!map) {
    console.error('鎵句笉鍒板湴鍥惧疄锟?);
    return;
  }
  
  console.log('鎵惧埌鍦板浘瀹炰緥锛屽噯澶囬噸鏂板姞杞芥爣锟?);
  
  // 鑾峰彇褰撳墠绛涢€夋潯锟?  const filterSelect = document.getElementById('map-filter-select');
  const currentFilter = filterSelect ? filterSelect.value : 'all';
  
  // 鏍规嵁绛涢€夋潯浠惰繃婊や綅�?  let filteredLocations = [];
  
  switch (currentFilter) {
    case 'china':
      filteredLocations = locations.filter(loc => loc.country === '涓�?);
      break;
    case 'international':
      filteredLocations = locations.filter(loc => loc.country !== '涓�?);
      break;
    case 'wild':
      filteredLocations = locations.filter(loc => {
        return (loc.types && loc.types.includes('wild')) || loc.type === 'wild';
      });
      break;
    case 'captive':
      filteredLocations = locations.filter(loc => {
        return (loc.types && loc.types.includes('captive')) || loc.type === 'captive';
      });
      break;
    case 'research':
      filteredLocations = locations.filter(loc => {
        return (loc.types && loc.types.includes('research')) || loc.type === 'research';
      });
      break;
    default:
      filteredLocations = locations;
  }
  
  // 閲嶆柊鍔犺浇鏍囪�?
  addPandaMarkersLeaflet(map, filteredLocations);
}

// 鍔犺浇杞欢璁剧疆椤甸潰
function loadAppSettings() {
  const contentContainer = document.getElementById('content-container');
  
  // 鏄剧ず鍔犺浇鐘讹�?  contentContainer.innerHTML = '<div class="loading-container"><div class="loading-spinner"></div><p>姝ｅ湪鍔犺浇杞欢璁剧疆...</p></div>';
  
  try {
    // 鑾峰彇褰撳墠涓婚璁剧疆
    const currentTheme = localStorage.getItem('appTheme') || 'light';
    const currentBackground = localStorage.getItem('appBackground') || 'default';
    const currentFontSize = localStorage.getItem('appFontSize') || 'medium';
    const autoRefreshEnabled = localStorage.getItem('autoRefreshEnabled') === 'true';
    const refreshInterval = localStorage.getItem('refreshInterval') || '60';
    
    // 鏋勫缓璁剧疆椤甸潰HTML
    let settingsHtml = `
      <div class="page-container settings-page">
        <h2>杞欢璁剧疆</h2>
        
        <div class="settings-section">
          <h3>澶栬璁剧疆</h3>
          <div class="settings-group">
            <div class="settings-item">
              <label for="theme-select">涓婚棰滆壊�?/label>
              <select id="theme-select" class="settings-select">
                <option value="light" ${currentTheme === 'light' ? 'selected' : ''}>娴呰壊涓婚</option>
                <option value="dark" ${currentTheme === 'dark' ? 'selected' : ''}>娣辫壊涓婚</option>
                <option value="panda" ${currentTheme === 'panda' ? 'selected' : ''}>鐔婄尗涓婚</option>
                <option value="forest" ${currentTheme === 'forest' ? 'selected' : ''}>妫灄涓婚</option>
                <option value="bamboo" ${currentTheme === 'bamboo' ? 'selected' : ''}>绔规灄涓婚</option>
              </select>
            </div>
            
            <div class="settings-item">
              <label for="background-select">鑳屾櫙鏍峰紡�?/label>
              <select id="background-select" class="settings-select">
                <option value="default" ${currentBackground === 'default' ? 'selected' : ''}>榛樿鑳屾櫙</option>
                <option value="gradient" ${currentBackground === 'gradient' ? 'selected' : ''}>娓愬彉鑳屾櫙</option>
                <option value="pattern" ${currentBackground === 'pattern' ? 'selected' : ''}>绔瑰彾鍥炬</option>
                <option value="image1" ${currentBackground === 'image1' ? 'selected' : ''}>鐔婄尗鑳屾櫙1</option>
                <option value="image2" ${currentBackground === 'image2' ? 'selected' : ''}>鐔婄尗鑳屾櫙2</option>
              </select>
            </div>
            
            <div class="settings-item">
              <label for="font-size-select">瀛椾綋澶у皬锟?/label>
              <select id="font-size-select" class="settings-select">
                <option value="small" ${currentFontSize === 'small' ? 'selected' : ''}>灏忓彿瀛椾�?/option>
                <option value="medium" ${currentFontSize === 'medium' ? 'selected' : ''}>涓彿瀛椾�?/option>
                <option value="large" ${currentFontSize === 'large' ? 'selected' : ''}>澶у彿瀛椾�?/option>
                <option value="xlarge" ${currentFontSize === 'xlarge' ? 'selected' : ''}>瓒呭ぇ瀛椾�?/option>
              </select>
            </div>
            
            <div class="settings-item theme-preview">
              <label>涓婚棰勮�?/label>
              <div id="theme-preview-container" class="theme-preview-container ${currentTheme}">
                <div class="preview-header">
                  <div class="preview-logo">宸濆皬鐔婄尗</div>
                  <div class="preview-nav">
                    <span>鐔婄尗鍦板浘</span>
                    <span>鐔婄尗鍔拷?/span>
                    <span>鐔婄尗鐭ヨ瘑</span>
                  </div>
                </div>
                <div class="preview-content">
                  <div class="preview-card">
                    <h4>澶х唺鐚柊锟?/h4>
                    <p>杩欐槸涓€鏉＄ず渚嬫柊闂诲唴瀹癸紝灞曠ず褰撳墠涓婚鐨勬樉绀烘晥鏋滐�?/p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="settings-section">
          <h3>鏁版嵁鏇存柊璁剧�?/h3>
          <div class="settings-group">
            <div class="settings-item">
              <label class="checkbox-label">
                <input type="checkbox" id="auto-refresh-checkbox" ${autoRefreshEnabled ? 'checked' : ''}>
                <span>鍚敤鑷姩鏇存柊鏁版嵁</span>
              </label>
            </div>
            
            <div class="settings-item">
              <label for="refresh-interval">鏇存柊闂撮殧(�?�?/label>
              <input type="number" id="refresh-interval" min="30" max="600" value="${refreshInterval}">
            </div>
          </div>
        </div>
        
        <div class="settings-section">
          <h3>搴旂敤淇℃伅</h3>
          <div class="settings-group">
            <div class="settings-item">
              <label>搴旂敤鐗堟湰�?/label>
              <span>1.0.0</span>
            </div>
            <div class="settings-item">
              <label>鏁版嵁鏉ユ簮�?/label>
              <span>閫氫箟鍗冮棶API</span>
            </div>
            <div class="settings-item">
              <button id="reset-settings" class="settings-button danger">鎭㈠榛樿璁剧�?/button>
              <button id="save-settings" class="settings-button primary">淇濆瓨璁剧疆</button>
            </div>
          </div>
        </div>
      </div>
    `;
    
    // 鏇存柊鍐呭
    contentContainer.innerHTML = settingsHtml;
    
    // 娣诲姞璁剧疆鍙樻洿浜嬩欢
    const themeSelect = document.getElementById('theme-select');
    const backgroundSelect = document.getElementById('background-select');
    const fontSizeSelect = document.getElementById('font-size-select');
    const themePreviewContainer = document.getElementById('theme-preview-container');
    
    // 涓婚棰勮鏁堟�?
    if (themeSelect && themePreviewContainer) {
      themeSelect.addEventListener('change', function() {
        // 鏇存柊棰勮瀹瑰櫒鐨勭被
        themePreviewContainer.className = 'theme-preview-container ' + this.value;
      });
    }
    
    // 淇濆瓨璁剧疆鎸夐�?
    const saveButton = document.getElementById('save-settings');
    if (saveButton) {
      saveButton.addEventListener('click', function() {
        // 鑾峰彇鎵€鏈夎�?        const newTheme = themeSelect.value;
        const newBackground = backgroundSelect.value;
        const newFontSize = fontSizeSelect.value;
        const newAutoRefresh = document.getElementById('auto-refresh-checkbox').checked;
        const newRefreshInterval = document.getElementById('refresh-interval').value;
        
        // 淇濆瓨鍒發ocalStorage
        localStorage.setItem('appTheme', newTheme);
        localStorage.setItem('appBackground', newBackground);
        localStorage.setItem('appFontSize', newFontSize);
        localStorage.setItem('autoRefreshEnabled', newAutoRefresh);
        localStorage.setItem('refreshInterval', newRefreshInterval);
        
        // 搴旂敤鏂拌�?        applyAppSettings();
        
        // 鏄剧ず鑷畾涔夋彁绀烘
        showCustomAlert({
          title: '璁剧疆宸蹭繚�?,
          message: '鎮ㄧ殑璁剧疆宸叉垚鍔熶繚瀛樺苟搴旂敤�?,
          confirmText: '濂界�?
        });
      });
    }
    
    // 閲嶇疆璁剧疆鎸夐�?
    const resetButton = document.getElementById('reset-settings');
    if (resetButton) {
      resetButton.addEventListener('click', function() {
        // 浣跨敤鑷畾涔夌‘璁ゆ
        showCustomAlert({
          title: '纭閲嶇疆',
          message: '纭畾瑕佹仮澶嶆墍鏈夐粯璁よ缃悧�?,
          confirmText: '纭�?,
          cancelText: '鍙栨�?,
          showCancel: true,
          onConfirm: () => {
            // 娓呴櫎鎵€鏈夎�?            localStorage.removeItem('appTheme');
            localStorage.removeItem('appBackground');
            localStorage.removeItem('appFontSize');
            localStorage.removeItem('autoRefreshEnabled');
            localStorage.removeItem('refreshInterval');
            
            // 閲嶆柊鍔犺浇璁剧疆椤甸潰
            loadAppSettings();
            
            // 搴旂敤榛樿璁剧�?
            applyAppSettings();
          }
        });
      });
    }
  } catch (error) {
    console.error('鍔犺浇杞欢璁剧疆澶辫触:', error);
    contentContainer.innerHTML = '<div class="error-container"><p>鍔犺浇杞欢璁剧疆澶辫触锛岃绋嶅悗鍐嶈瘯锟?/p></div>';
  }
}

// 搴旂敤杞欢璁剧�?
function applyAppSettings() {
  // 鑾峰彇褰撳墠璁剧�?
  const currentTheme = localStorage.getItem('appTheme') || 'light';
  const currentBackground = localStorage.getItem('appBackground') || 'default';
  const currentFontSize = localStorage.getItem('appFontSize') || 'medium';
  const autoRefreshEnabled = localStorage.getItem('autoRefreshEnabled') === 'true';
  const refreshInterval = parseInt(localStorage.getItem('refreshInterval') || '60') * 1000;
  
  // 搴旂敤涓婚 - 鍏堟竻闄ゆ墍鏈夌浉鍏崇殑�?  document.body.classList.remove(
    'theme-light', 'theme-dark', 'theme-panda', 'theme-forest', 'theme-bamboo',
    'bg-default', 'bg-gradient', 'bg-pattern', 'bg-image1', 'bg-image2',
    'font-small', 'font-medium', 'font-large', 'font-xlarge'
  );
  
  // 搴旂敤涓婚鍜岃儗锟?  document.body.classList.add(`theme-${currentTheme}`);
  document.body.classList.add(`bg-${currentBackground}`);
  document.body.classList.add(`font-${currentFontSize}`);
  
  // 鐩存帴鍦ㄦ枃妗ｆ牴鍏冪礌涓婅缃瓧浣撳ぇ灏廋SS鍙橀�?
  const fontSizeValue = {
    'small': '14px',
    'medium': '16px',
    'large': '18px',
    'xlarge': '20px'
  }[currentFontSize] || '16px';
  
  document.documentElement.style.setProperty('--font-size-base', fontSizeValue);
  
  // 搴旂敤鑷姩鍒锋柊璁剧疆
  if (typeof autoRefresh !== 'undefined') {
    if (autoRefreshEnabled) {
      // 鑾峰彇褰撳墠椤甸�?
      const activeNavItem = document.querySelector('.main-nav li.active');
      const currentPage = activeNavItem ? activeNavItem.getAttribute('data-page') : null;
      
      // 鏍规嵁褰撳墠椤甸潰閫夋嫨鍒锋柊鍑芥暟
      if (currentPage === 'news') {
        autoRefresh.startAutoRefresh(loadPandaNews, refreshInterval);
      } else if (currentPage === 'live') {
        autoRefresh.startAutoRefresh(refreshLiveData, refreshInterval);
      }
    } else {
      autoRefresh.stopAutoRefresh();
    }
  }
  
  console.log('搴旂敤璁剧疆宸叉洿锟?', {
    涓婚�? currentTheme,
    鑳屾�? currentBackground,
    瀛椾綋澶у�? currentFontSize,
    鑷姩鍒锋柊: autoRefreshEnabled,
    鍒锋柊闂撮殧: refreshInterval + 'ms'
  });
}

// 鍦ㄦ枃妗ｅ姞杞藉畬鎴愬悗搴旂敤璁剧疆
document.addEventListener('DOMContentLoaded', () => {
  // 鍦ㄥ垱寤哄簲鐢ㄥ竷灞€鍚庡簲鐢ㄨ锟?  setTimeout(applyAppSettings, 100);
});

// 鍒涘缓鑷畾涔夋彁绀烘
function showCustomAlert(options) {
  // 榛樿閫夐�?
  const defaults = {
    title: '鎻愮�?,
    message: '',
    confirmText: '纭�?,
    cancelText: '鍙栨�?,
    showCancel: false,
    onConfirm: () => {},
    onCancel: () => {},
    theme: document.body.classList.contains('theme-dark') ? 'dark' : 'light'
  };
  
  // 鍚堝苟閫夐�?
  const settings = { ...defaults, ...options };
  
  // 鍒涘缓閬僵�?  const overlay = document.createElement('div');
  overlay.className = 'custom-alert-overlay';
  document.body.appendChild(overlay);
  
  // 鍒涘缓鎻愮ず�?  const alertBox = document.createElement('div');
  alertBox.className = 'custom-alert-box';
  
  // 鍒涘缓澶撮儴
  const header = document.createElement('div');
  header.className = 'custom-alert-header';
  header.innerHTML = `
    <span>${settings.title}</span>
    <button class="close-btn">&times;</button>
  `;
  
  // 鍒涘缓鍐呭
  const content = document.createElement('div');
  content.className = 'custom-alert-content';
  content.innerHTML = settings.message;
  
  // 鍒涘缓搴曢儴鎸夐�?
  const footer = document.createElement('div');
  footer.className = 'custom-alert-footer';
  
  let confirmButton = document.createElement('button');
  confirmButton.className = 'custom-alert-btn primary';
  confirmButton.textContent = settings.confirmText;
  
  let cancelButton;
  if (settings.showCancel) {
    cancelButton = document.createElement('button');
    cancelButton.className = 'custom-alert-btn default';
    cancelButton.textContent = settings.cancelText;
    footer.appendChild(cancelButton);
  }
  
  footer.appendChild(confirmButton);
  
  // 缁勮鎻愮ず�?  alertBox.appendChild(header);
  alertBox.appendChild(content);
  alertBox.appendChild(footer);
  overlay.appendChild(alertBox);
  
  // 娣诲姞鍔ㄧ敾�?  setTimeout(() => {
    overlay.classList.add('show');
  }, 10);
  
  // 鍏抽棴鎻愮ず妗嗗嚱锟?  const closeAlert = () => {
    overlay.classList.remove('show');
    setTimeout(() => {
      document.body.removeChild(overlay);
    }, 300);
  };
  
  // 缁戝畾浜嬩欢
  header.querySelector('.close-btn').addEventListener('click', () => {
    closeAlert();
    if (settings.onCancel) settings.onCancel();
  });
  
  confirmButton.addEventListener('click', () => {
    closeAlert();
    if (settings.onConfirm) settings.onConfirm();
  });
  
  if (settings.showCancel) {
    cancelButton.addEventListener('click', () => {
      closeAlert();
      if (settings.onCancel) settings.onCancel();
    });
  }
  
  // 鐐瑰嚮閬僵灞傚叧锟?  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) {
      closeAlert();
      if (settings.onCancel) settings.onCancel();
    }
  });
  
  // ESC閿叧锟?  const escKeyHandler = (e) => {
    if (e.key === 'Escape') {
      closeAlert();
      if (settings.onCancel) settings.onCancel();
      document.removeEventListener('keydown', escKeyHandler);
    }
  };
  document.addEventListener('keydown', escKeyHandler);
  
  return {
    close: closeAlert
  };
}


