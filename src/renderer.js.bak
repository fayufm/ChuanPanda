    // 鍏抽棴鍥藉唴鐩戞帶鍒嗙粍锛屾坊鍔犲浗澶栫洃鎺у垎锟?    liveHtml += `
                </div>
              </div>
              
              <!-- 鍥藉鐩戞帶鍒嗙�?-->
              <div class="live-group">
                <h3 class="live-group-title">鍥藉鐔婄尗鐩戞�?/h3>
                <div class="live-container">
    `;
    
    // 娣诲姞鍥藉鐩存挱锟?    const internationalSources = liveData.liveSources.slice(6); // �?涓箣鍚庢槸鍥藉鐩戞帶
    internationalSources.forEach((live, index) => {
      // 瀹為檯绱㈠紩
