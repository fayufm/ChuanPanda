                el.textContent === '袣褍谢褜褌褍褉薪芯械 蟹薪邪褔械薪懈械') {
        el.textContent = '鏂囧寲鎰忎箟';
      } else if (el.textContent === 'Multi-language Translation' || 
                el.textContent === '袦薪芯谐芯褟蟹褘褔薪褘泄 锌械褉械胁芯�?) {
        el.textContent = '澶氳瑷€缈昏瘧';
      }
    });
    
    // 鎭㈠娈佃惤鏂囨�?
    paragraphElements.forEach(el => {
      // 杩欓噷鍙互娣诲姞鎭㈠涓枃鏂囨湰鐨勯€昏緫锛屼絾鐢变簬鍘熷HTML宸茬粡鍖呭惈涓枃鍐呭
      // 鎴戜滑鍙互绠€鍗曞湴閲嶆柊鍔犺浇椤甸潰涓殑鍐呭锛岃€屼笉鏄皟鐢╨oadPandaKnowledge()
      
      // 鏌ユ壘鍖呭惈鐗瑰畾鑻辨枃鎴栦縿鏂囩殑娈佃惤锛屾仮澶嶄负涓枃
      if (el.textContent.includes('Giant pandas are one of the most popular endangered animals') ||
          el.textContent.includes('袘芯谢褜褕邪�?锌邪薪写�?褟胁谢褟械褌褋褟 芯写薪懈�?懈蟹 褋邪屑褘�?锌芯锌褍谢褟褉薪褘褏')) {
        el.textContent = '澶х唺鐚槸涓栫晫涓婃渶鍙楁杩庣殑婵掑嵄鍔ㄧ墿涔嬩竴锛屾垚骞村ぇ鐔婄尗浣撻暱�?.2-1.5绫筹紝浣撻噸�?00-150鍗冨厠銆傚畠浠嫢鏈夋爣蹇楁€х殑榛戠櫧姣涜壊锛岄粦鑹查儴鍒嗗寘鎷溂鐫涘懆鍥淬€佽€虫湹銆侀蓟瀛愩€佽偐鑶€鍜屽洓鑲紝鍏朵綑閮ㄥ垎涓虹櫧鑹诧�?;
      } else if (el.textContent.includes('Giant pandas have a unique "sixth finger"') ||
                el.textContent.includes('袘芯谢褜褕懈�?锌邪薪写�?懈屑械褞�?褍薪懈泻邪谢褜薪褘泄 "褕械褋褌芯泄 锌邪谢械�?')) {
        el.textContent = '澶х唺鐚嫢鏈夌嫭鐗圭�?绗叚锟?锛堣厱楠ㄦ紨鍙樿€屾潵鐨勬媷鎸囷級锛岃繖浣垮畠浠兘澶熻交鏉炬彙浣忕瀛愩€傚畠浠殑娑堝寲绯荤粺铏界劧灞炰簬椋熻倝鍔ㄧ墿锛屼絾宸茬粡閫傚簲浜嗕互绔瑰瓙涓轰富鐨勯ギ椋熶範鎯�?;
      } else if (el.textContent.includes('Currently, wild giant pandas are mainly distributed') ||
                el.textContent.includes('�?薪邪褋褌芯褟褖械�?胁褉械屑�?写懈泻懈�?斜芯谢褜褕懈�?锌邪薪写�?)) {
        el.textContent = '鐩墠锛岄噹鐢熷ぇ鐔婄尗涓昏鍒嗗竷鍦ㄤ腑鍥藉洓宸濈渷锛堢害1,200鍙級銆侀檿瑗跨渷锛堢�?00澶氬彧锛夊拰鐢樿們鐪侊紙�?00澶氬彧锛夌殑灞卞尯锛屾€绘暟宸叉帴锟?,900鍙€傚ぇ鐔婄尗淇濇姢鍖烘€婚潰绉揪鍒扮害260涓囧叕椤凤拷?;
      }
    });
    
    // 鎭㈠鍒楄〃椤瑰唴�?    listItemElements.forEach(el => {
      const strongTag = el.querySelector('strong');
      if (strongTag) {
        // 鎭㈠灏忔爣棰橈紙甯︽湁strong鏍囩鐨勯儴鍒嗭�?
        const subtitle = strongTag.textContent.replace(': ', '');
        switch (subtitle) {
          case 'Diet':
          case '袩懈褌邪薪懈�?:
            strongTag.textContent = '楗锟?;
            break;
          case 'Activity':
          case '袗泻褌懈胁薪芯褋褌褜':
            strongTag.textContent = '娲诲姩锟?;
            break;
          case 'Reproduction':
          case '袪邪蟹屑薪芯卸械薪懈�?:
            strongTag.textContent = '绻佹畺锟?;
            break;
          case 'Lifespan':
          case '袩褉芯写芯谢卸懈褌械谢褜薪芯褋褌�?卸懈蟹薪�?:
            strongTag.textContent = '瀵垮懡锟?;
            break;
          case 'Territorial Behavior':
          case '孝械褉褉懈褌芯褉懈邪谢褜薪芯�?锌芯胁械写械薪懈�?:
            strongTag.textContent = '棰嗗湴琛屼负�?;
            break;
          case 'Communication Methods':
          case '小锌芯褋芯斜�?泻芯屑屑褍薪懈泻邪褑懈懈':
            strongTag.textContent = '浜ゆ祦鏂瑰紡�?;
            break;
          case 'Activity Patterns':
          case '袪械卸懈�?邪泻褌懈胁薪芯褋褌懈':
            strongTag.textContent = '娲诲姩瑙勫緥�?;
            break;
          case 'Temperature Regulation':
          case '袪械谐褍谢褟褑懈�?褌械屑锌械褉邪褌褍褉�?:
            strongTag.textContent = '浣撴俯璋冭妭�?;
            break;
        }
      }
    });
  }
}

// 鍒涘缓鍒锋柊瀹炴椂鏁版嵁鐨勫嚱锟?async function refreshLiveData() {
  try {
    // 鑾峰彇API瀹炰�?
    const api = getAPI();
    if (!api) {
      throw new Error('API鏈嶅姟涓嶅彲�?);
    }
    
    // 鑾峰彇鏈€鏂扮洿鎾暟锟?    const liveData = await api.getPandaLiveInfo();
    
    // 鏇存柊鐜鏁版�?
    if (liveData.monitoringData && liveData.monitoringData.environmentalData) {
      updateEnvironmentData(liveData.monitoringData.environmentalData);
    }
    
    // 鏇存柊鐔婄尗鐘舵€佹暟锟?    if (liveData.monitoringData && liveData.monitoringData.pandaStatus) {
      updatePandaStatusData(liveData.monitoringData.pandaStatus);
    }
    
    // 鏇存柊缁熻鏁版�?
    if (liveData.monitoringData && liveData.monitoringData.statisticsData) {
      updateStatisticsData(liveData.monitoringData.statisticsData);
    }
    
    // 鏇存柊鐩存挱婧愮姸锟?    if (liveData.liveSources) {
      updateLiveSourcesStatus(liveData.liveSources);
    }
    
    return true;
  } catch (error) {
    console.error('鍒锋柊鐩存挱鏁版嵁澶辫触:', error);
    return false;
  }
}

// 鏇存柊鐜鏁版�?
function updateEnvironmentData(environmentalData) {
  environmentalData.forEach(env => {
    const envCard = document.querySelector(`.environment-card[data-location="${env.location}"]`);
    if (envCard) {
      // 鏇存柊娓╁害
      const tempElement = envCard.querySelector('.env-value[data-type="temperature"]');
      if (tempElement) {
        tempElement.textContent = `${env.temperature}掳C`;
      }
      
      // 鏇存柊婀垮害
      const humidityElement = envCard.querySelector('.env-value[data-type="humidity"]');
      if (humidityElement) {
        humidityElement.textContent = `${env.humidity}%`;
      }
      
      // 鏇存柊姘斿帇
      const pressureElement = envCard.querySelector('.env-value[data-type="pressure"]');
      if (pressureElement) {
        pressureElement.textContent = `${env.pressure} hPa`;
      }
      
      // 鏇存柊绌烘皵璐ㄩ�?
      const airQualityElement = envCard.querySelector('.env-value[data-type="airQuality"]');
      if (airQualityElement) {
        airQualityElement.textContent = env.airQuality;
      }
      
      // 鏇存柊鏃堕棿�?      const updateElement = envCard.querySelector('.env-update');
      if (updateElement) {
        updateElement.textContent = '涓婃鏇存柊: 鍒氬�?;
      }
    }
  });
}

// 鏇存柊鐔婄尗鐘舵€佹暟锟?function updatePandaStatusData(pandaStatus) {
  pandaStatus.forEach(panda => {
    const pandaCard = document.querySelector(`.panda-card[data-name="${panda.name}"]`);
    if (pandaCard) {
      // 鏇存柊浣嶇疆
      const locationElement = pandaCard.querySelector('.panda-value[data-type="location"]');
      if (locationElement) {
        locationElement.textContent = panda.location;
      }
      
      // 鏇存柊鍋ュ悍鐘跺�?
      const healthElement = pandaCard.querySelector('.panda-value[data-type="health"]');
      if (healthElement) {
        healthElement.textContent = panda.health;
      }
      
      // 鏇存柊褰撳墠娲诲�?
      const activityElement = pandaCard.querySelector('.panda-value[data-type="activity"]');
      if (activityElement) {
        activityElement.textContent = panda.activity;
      }
      
      // 鏇存柊鏃堕棿�?      const updateElement = pandaCard.querySelector('.panda-update');
      if (updateElement) {
        updateElement.textContent = '涓婃鏇存柊: 鍒氬�?;
      }
    }
  });
}

// 鏇存柊缁熻鏁版�?
function updateStatisticsData(statisticsData) {
  // 鏇存柊褰撳墠瑙傜湅浜烘暟
  const viewersElement = document.querySelector('.stat-value[data-type="viewers"]');
  if (viewersElement) {
    viewersElement.textContent = statisticsData.totalViewers;
  }
  
  // 鏇存柊鍦ㄧ嚎鐩戞帶鏁伴噺
  const streamsElement = document.querySelector('.stat-value[data-type="streams"]');
  if (streamsElement) {
    streamsElement.textContent = statisticsData.activeStreams;
  }
  
  // 鏇存柊楂樺嘲瑙傜湅鏃舵
  const peakElement = document.querySelector('.stat-value[data-type="peak"]');
  if (peakElement) {
    peakElement.textContent = statisticsData.peakViewingTime;
  }
  
  // 鏇存柊鏈€鍙楁杩庣洃锟?  const popularElement = document.querySelector('.stat-value[data-type="popular"]');
  if (popularElement) {
    popularElement.textContent = statisticsData.popularStream;
  }
}

// 鏇存柊鐩存挱婧愮姸锟?function updateLiveSourcesStatus(liveSources) {
  liveSources.forEach((live, index) => {
    const liveItem = document.querySelector(`.live-item[data-index="${index}"]`);
    if (liveItem) {
      // 鏇存柊鐘舵€佹爣�?      const statusElement = liveItem.querySelector('.stream-status');
      if (statusElement) {
        statusElement.textContent = live.status;
        
        // 鏇存柊鐘舵€佺被�?        statusElement.className = 'stream-status';
        if (live.status === '鍦ㄧ�?) {
          statusElement.classList.add('status-online');
        } else {
          statusElement.classList.add('status-offline');
        }
      }
      
      // 鏇存柊鎾斁鎸夐�?
      const playButton = liveItem.querySelector('.play-button');
      if (playButton) {
        playButton.className = 'play-button';
        if (live.status === '鍦ㄧ�?) {
          playButton.classList.add('status-online');
          playButton.textContent = '�?鎾斁鐩存挱';
          playButton.disabled = false;
        } else {
          playButton.classList.add('status-offline');
          playButton.textContent = '�?' + live.status;
          playButton.disabled = true;
        }
      }
    }
  });
}

async function loadPandaLive() {
  const contentContainer = document.getElementById('content-container');
  
  // 鏄剧ず鍔犺浇鐘讹�?  contentContainer.innerHTML = '<div class="loading-container"><div class="loading-spinner"></div><p>姝ｅ湪鍔犺浇鐔婄尗鐩存挱...</p></div>';
  
  try {
    // 鑾峰彇API瀹炰�?
    const api = getAPI();
    if (!api) {
      throw new Error('API鏈嶅姟涓嶅彲�?);
    }
    
    // 鑾峰彇鐩存挱鏁版�?
    const liveData = await api.getPandaLiveInfo();
    
    // 鏋勫缓鐩存挱HTML
    let liveHtml = `
      <div class="page-container live-page">
        <h2>鐔婄尗瀹炴椂鐩戞帶涓�?/h2>
        
        <!-- 鐩戞帶鏁版嵁姒傝�?-->
        <div class="monitoring-overview">
          <div class="overview-card">
