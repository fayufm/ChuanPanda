            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-label">褰撳墠瑙傜湅浜烘�?/span>
                <span class="stat-value" data-type="viewers">${liveData.monitoringData.statisticsData.totalViewers}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">鍦ㄧ嚎鐩戞帶</span>
                <span class="stat-value" data-type="streams">${liveData.monitoringData.statisticsData.activeStreams}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">楂樺嘲瑙傜湅鏃舵�?/span>
                <span class="stat-value" data-type="peak">${liveData.monitoringData.statisticsData.peakViewingTime}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">鏈€鍙楁杩庣洃�?/span>
                <span class="stat-value" data-type="popular">${liveData.monitoringData.statisticsData.popularStream}</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- 鐩戞帶鏍囩�?-->
        <div class="monitor-tabs">
          <div class="tab-header">
            <button class="tab-btn active" data-tab="live-streams">瀹炴椂鐩存挱</button>
            <button class="tab-btn" data-tab="environment">鐜鐩戞祴</button>
            <button class="tab-btn" data-tab="pandas">鐔婄尗鐘讹拷?/button>
            <button class="tab-btn" data-tab="history">鍘嗗彶鍥炴斁</button>
          </div>
          
          <div class="tab-content">
            <!-- 瀹炴椂鐩存挱鏍囩鍐呭 -->
            <div class="tab-pane active" id="live-streams">
              <!-- 鍥藉唴鐩戞帶鍒嗙�?-->
              <div class="live-group">
                <h3 class="live-group-title">鍥藉唴鐔婄尗鐩戞�?/h3>
                <div class="live-container">
    `;
    
    // 娣诲姞鍥藉唴鐩存挱锟?    const domesticSources = liveData.liveSources.slice(0, 6); // �?涓槸鍥藉唴鐩戞�?
    domesticSources.forEach((live, index) => {
      // 鏍规嵁鐩存挱绫诲瀷娣诲姞涓嶅悓鐨勬爣�?      let typeIcon = '';
      if (live.type === 'infrared') {
        typeIcon = '<span class="stream-type infrared">绾㈠�?/span>';
      } else if (live.type === 'video') {
        typeIcon = '<span class="stream-type video">瑙嗛�?/span>';
      }
      
      // 鏍规嵁鐘舵€佹坊鍔犱笉鍚岀殑鏍峰紡
      let statusClass = 'status-online';
      if (live.status !== '鍦ㄧ�?) {
        statusClass = 'status-offline';
      }
      
      liveHtml += `
        <div class="live-item" data-index="${index}">
          <h3>${live.name} ${typeIcon}</h3>
          <div class="live-player">
            <img src="${live.image}" alt="鐔婄尗鐩存挱" class="live-placeholder">
            <div class="live-controls">
              <button class="play-button ${statusClass}" data-url="${live.url}" ${live.status !== '鍦ㄧ�? ? 'disabled' : ''}>
                ${live.status === '鍦ㄧ�? ? '�?鎾斁鐩存挱' : '�?' + live.status}
              </button>
