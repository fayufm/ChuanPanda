      } else if (live.name.includes('鑽峰�?)) {
        countryFlag = '<span class="country-flag">馃嚦馃嚤</span>';
      } else if (live.name.includes('闊╁�?)) {
        countryFlag = '<span class="country-flag">馃嚢馃嚪</span>';
      } else if (live.name.includes('鑺�?)) {
        countryFlag = '<span class="country-flag">馃嚝馃嚠</span>';
      }
      
      // 鏍规嵁鐘舵€佹坊鍔犱笉鍚岀殑鏍峰紡
      let statusClass = 'status-online';
      if (live.status !== '鍦ㄧ�?) {
        statusClass = 'status-offline';
      }
      
      liveHtml += `
