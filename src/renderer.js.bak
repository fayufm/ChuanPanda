let autoRefresh;
try {
  autoRefresh = require('./autoRefresh.js');
} catch (error) {
  console.error('鍔犺浇鑷姩鍒锋柊妯″潡澶辫�?', error);
  // 鍒涘缓涓€涓┖鐨勬ā鎷熸ā鍧楋紝浠ラ槻妯″潡鍔犺浇澶辫触
  autoRefresh = {
    initAutoRefresh: () => {},
    startAutoRefresh: () => {},
    stopAutoRefresh: () => {},
    toggleAutoRefresh: () => {},
    updateLastRefreshTime: () => {}
  };
}

document.addEventListener('DOMContentLoaded', () => {
  const app = document.getElementById('app');
  
  // 鍒涘缓搴旂敤绋嬪簭甯冨眬
  createAppLayout(app);
  
  // 鍒濆鍖栧鑸簨锟?  initNavEvents();
  
  // 榛樿鍔犺浇鐔婄尗鍔ㄦ€侀〉锟?  // 纭繚UI鐘舵€佷笌鍔犺浇鐨勯〉闈竴�?  const newsNavItem = document.querySelector('.main-nav li[data-page="news"]');
  if (newsNavItem) {
    newsNavItem.classList.add('active');
  }
  loadPandaNews();
});

// 鍒涘缓搴旂敤绋嬪簭甯冨眬
function createAppLayout(container) {
  container.innerHTML = `
    <div class="app-container">
      <div class="custom-titlebar">
        <div class="titlebar-drag-region">
          <div class="titlebar-icon">
            <img src="./assets/panda_logo1.png" alt="宸濆皬鐔婄尗" class="titlebar-logo">
          </div>
          <div class="titlebar-title">宸濆皬鐔婄尗 - 鍏ㄧ悆鐔婄尗鍔ㄦ€佹煡鐪嬪櫒</div>
        </div>
        <div class="titlebar-controls">
          <button class="titlebar-button" id="minimize-btn" title="鏈€灏忓�?>
            <svg width="12" height="12" viewBox="0 0 12 12">
              <rect x="1" y="6" width="10" height="1" fill="currentColor" />
            </svg>
          </button>
          <button class="titlebar-button" id="maximize-btn" title="鏈€澶у寲">
            <svg width="12" height="12" viewBox="0 0 12 12">
              <rect x="1.5" y="1.5" width="9" height="9" stroke="currentColor" fill="none" stroke-width="1.25"/>
            </svg>
          </button>
          <button class="titlebar-button close-button" id="close-btn" title="鍏抽�?>
            <svg width="12" height="12" viewBox="0 0 12 12">
              <line x1="1" y1="1" x2="11" y2="11" stroke="currentColor" stroke-width="1.5" />
              <line x1="1" y1="11" x2="11" y2="1" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
        </div>
      </div>
      <header class="app-header">
        <div class="logo-container">
          <div class="custom-logo">
            <img src="./assets/panda_logo1.png" alt="宸濆皬鐔婄尗" class="app-logo-image">
            <div class="logo-overlay">鐔婄�?/div>
          </div>
          <h1>宸濆皬鐔婄尗</h1>
        </div>
        <nav class="main-nav">
          <ul>
            <li data-page="map">鐔婄尗鍦板浘</li>
            <li data-page="news" class="active">鐔婄尗鍔拷?/li>
            <li data-page="knowledge">鐔婄尗鐭ヨ瘑</li>
            <li data-page="live">瀹炴椂鐩戞帶</li>
            <li data-page="settings">杞欢璁剧疆</li>
          </ul>
        </nav>
      </header>
      <main class="app-content">
        <div id="content-container" class="content-container">
          <!-- 鍐呭灏嗗姩鎬佸姞杞藉埌杩欓�?-->
          <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>姝ｅ湪鍔犺浇鐔婄尗鏁版嵁...</p>
          </div>
        </div>
      </main>
    </div>
  `;
  
  // 娣诲姞鏍囬鏍忔帶鍒舵寜閽簨锟?  const api = getAPI();
  if (api && api.minimizeWindow) {
    document.getElementById('minimize-btn').addEventListener('click', () => {
      api.minimizeWindow();
    });
    
    document.getElementById('maximize-btn').addEventListener('click', async () => {
      const isMaximized = await api.maximizeWindow();
      const maximizeBtn = document.getElementById('maximize-btn');
      
      // 鏍规嵁绐楀彛鐘舵€佹洿鏂版寜閽浘�?      if (isMaximized) {
        maximizeBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 12 12">
            <rect x="1.5" y="1.5" width="7" height="7" stroke="currentColor" fill="none" stroke-width="1.25"/>
            <rect x="3.5" y="3.5" width="7" height="7" stroke="currentColor" fill="none" stroke-width="1.25"/>
          </svg>
        `;
        maximizeBtn.setAttribute('title', '杩樺�?);
      } else {
        maximizeBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 12 12">
            <rect x="1.5" y="1.5" width="9" height="9" stroke="currentColor" fill="none" stroke-width="1.25"/>
          </svg>
        `;
        maximizeBtn.setAttribute('title', '鏈€澶у寲');
      }
    });
    
    document.getElementById('close-btn').addEventListener('click', () => {
      api.closeWindow();
    });
  } else {
    // 濡傛灉涓嶅湪Electron鐜涓紝闅愯棌鑷畾涔夋爣棰樻爮
    const titlebar = document.querySelector('.custom-titlebar');
    if (titlebar) {
      titlebar.style.display = 'none';
    }
  }
}

// 鍒濆鍖栧鑸簨锟?function initNavEvents() {
  const navItems = document.querySelectorAll('.main-nav li');
  
  navItems.forEach(item => {
    item.addEventListener('click', function() {
      // 鑾峰彇褰撳墠椤甸潰鍜岀洰鏍囬〉锟?      const currentActivePage = document.querySelector('.main-nav li.active');
      const currentPage = currentActivePage ? currentActivePage.getAttribute('data-page') : null;
      const targetPage = this.getAttribute('data-page');
      
      console.log(`椤甸潰鍒囨崲: �?${currentPage} �?${targetPage}`);
      
      // 濡傛灉浠庣唺鐚姩鎬侀〉闈㈠垏鎹㈠埌鍏朵粬椤甸潰锛屾鏌ユ槸鍚﹂渶瑕佹殏鍋滆嚜鍔ㄥ埛锟?      if (currentPage === 'news' && targetPage !== 'news' && typeof autoRefresh !== 'undefined') {
        // 涓嶅仠姝㈣嚜鍔ㄥ埛鏂帮紝璁╅〉闈㈡鏌ラ€昏緫澶勭悊
        console.log('浠庣唺鐚姩鎬侀〉闈㈠垏鎹㈠埌鍏朵粬椤甸�?);
      }
      
      // 绉婚櫎鎵€鏈夋椿鍔ㄧ姸锟?      navItems.forEach(nav => nav.classList.remove('active'));
      
      // 娣诲姞褰撳墠娲诲姩鐘讹拷?      this.classList.add('active');
      
      // 鏍规嵁閫夋嫨鐨勯〉闈㈠姞杞藉唴锟?      const page = this.getAttribute('data-page');
      switch (page) {
        case 'map':
          loadPandaMap();
          break;
        case 'news':
          loadPandaNews();
          break;
        case 'knowledge':
          loadPandaKnowledge();
          break;
        case 'live':
          loadPandaLive();
          break;
        case 'settings':
          loadAppSettings();
          break;
      }
    });
  });
}

// 鑾峰彇API瀹炰�?
function getAPI() {
  // 妫€鏌ユ槸鍚﹀湪Electron鐜锟?  if (window.pandaAPI) {
    return window.pandaAPI;
  } else if (window.api) {
    // 娴忚鍣ㄧ幆澧冧腑鐨勬ā鎷烝PI
    return window.api;
  } else {
    console.error('鏈壘鍒癆PI鏈嶅�?);
    return null;
  }
}

// 瀛樺偍鍏ㄩ儴鏂伴椈鏁版嵁
let allPandaNews = [];
let currentDisplayedNews = 0;
const NEWS_PER_PAGE = 10;
const MAX_NEWS = 30;

// 鏍规嵁鏃ユ湡瀵规柊闂昏繘琛屾帓搴忥紙浠庢柊鍒版棫�?function sortNewsByDate(newsArray) {
  return [...newsArray].sort((a, b) => {
    // 浠庢棩鏈熷瓧绗︿覆涓彁鍙栧勾銆佹湀銆佹�?
    const getDateParts = (dateStr) => {
      if (!dateStr) return { year: 2000, month: 1, day: 1 };
      
      // 鍖归�?YYYY骞碝M鏈圖D�?鏍煎�?
      const match = dateStr.match(/(\d{4})�?\d{1,2})�?\d{1,2})�?);
      if (match) {
        return {
          year: parseInt(match[1]),
          month: parseInt(match[2]),
          day: parseInt(match[3])
        };
      }
      
      // 灏濊瘯鍖归厤鍏朵粬鍙兘鐨勬棩鏈熸牸�?      const altMatch = dateStr.match(/(\d{4})[/-](\d{1,2})[/-](\d{1,2})/);
      if (altMatch) {
        return {
          year: parseInt(altMatch[1]),
          month: parseInt(altMatch[2]),
          day: parseInt(altMatch[3])
        };
      }
      
      // 濡傛灉鏃犳硶瑙ｆ瀽鏃ユ湡锛岃繑鍥炰竴涓緢鏃╃殑鏃ユ�?
      return { year: 2000, month: 1, day: 1 };
    };
    
    const dateA = getDateParts(a.date);
    const dateB = getDateParts(b.date);
    
    // 姣旇緝骞翠唤
    if (dateA.year !== dateB.year) {
      return dateB.year - dateA.year;
    }
    // 骞翠唤鐩稿悓锛屾瘮杈冩湀�?    if (dateA.month !== dateB.month) {
      return dateB.month - dateA.month;
    }
    // 骞存湀鐩稿悓锛屾瘮杈冩�?
    return dateB.day - dateA.day;
  });
}

// 鍔犺浇鐔婄尗鍔ㄦ€侀〉锟?async function loadPandaNews() {
  console.log('loadPandaNews琚皟锟?);
  
  // 妫€鏌ュ綋鍓嶆縺娲荤殑椤甸潰鏄惁鏄唺鐚姩鎬侀〉锟?  const activeNavItem = document.querySelector('.main-nav li.active');
  const currentPage = activeNavItem ? activeNavItem.getAttribute('data-page') : null;
  console.log('褰撳墠椤甸潰:', currentPage);
  
  // 濡傛灉褰撳墠涓嶆槸鍦ㄧ唺鐚姩鎬侀〉闈紝涓斾笉鏄垵濮嬪姞杞斤紝鍒欏彧鑾峰彇鏁版嵁浣嗕笉鏇存柊UI
  const isInitialLoad = !document.querySelector('.page-container');
  
  // 妫€鏌ユ槸鍚︽槸鑷姩鍒锋柊瑙﹀彂鐨勮皟�?  const isAutoRefreshActive = typeof autoRefresh !== 'undefined' && 
                             autoRefresh.isAutoRefreshActive && 
                             autoRefresh.isAutoRefreshActive();
  
  // 濡傛灉涓嶆槸鐔婄尗鍔ㄦ€侀〉闈紝鍒欏彧鏇存柊鏁版嵁锛屼笉鍒锋柊UI
  if (currentPage !== 'news' && !isInitialLoad) {
    console.log('褰撳墠涓嶅湪鐔婄尗鍔ㄦ€侀〉闈紝鍙洿鏂版暟鎹笉鍒锋柊UI');
    try {
      // 鍙幏鍙栨暟鎹紝涓嶆洿鏂癠I
      const api = getAPI();
      if (api) {
        const newsData = await api.getLatestPandaNews();
        if (newsData && newsData.length > 0) {
          // 鏇存柊鍏ㄥ眬鏁版嵁浣嗕笉娓叉�?
          allPandaNews = sortNewsByDate(newsData);
        }
      }
    } catch (error) {
      console.error('鍚庡彴鏇存柊鐔婄尗鏂伴椈鏁版嵁澶辫触:', error);
    }
    return; // 鎻愬墠杩斿洖锛屼笉鎵цUI鏇存�?
  }
  
  // 鍐嶆纭褰撳墠椤甸潰鏄唺鐚姩鎬侀〉锟?  if (currentPage !== 'news' && !isInitialLoad) {
    console.log('褰撳墠涓嶅湪鐔婄尗鍔ㄦ€侀〉闈紝璺宠繃UI鏇存�?);
    return;
  }
  
  const contentContainer = document.getElementById('content-container');
  
  // 鏄剧ず鍔犺浇鐘讹�?  contentContainer.innerHTML = '<div class="loading-container"><div class="loading-spinner"></div><p>姝ｅ湪鍔犺浇鐔婄尗鍔拷?..</p></div>';
  
  try {
    // 鑾峰彇API瀹炰�?
    const api = getAPI();
    if (!api) {
      throw new Error('API鏈嶅姟涓嶅彲�?);
    }
    
    // 鑾峰彇鏂伴椈鏁版�?
    const newsData = await api.getLatestPandaNews();
    
    if (!newsData || newsData.length === 0) {
      throw new Error('鏈幏鍙栧埌鐔婄尗鏂伴椈鏁版�?);
    }
    
    // 瀵规柊闂昏繘琛屾帓搴忥紝纭繚鏈€鏂扮殑鏂伴椈鍦ㄦ渶涓婇�?
    const sortedNewsData = sortNewsByDate(newsData);
    
    // 淇濆瓨鎵€鏈夋柊闂绘暟鎹埌鍏ㄥ眬鍙橀�?
    allPandaNews = sortedNewsData;
    currentDisplayedNews = 0;
    
    // 鏈€鍚庝竴娆℃鏌ュ綋鍓嶉〉锟?    const finalCheck = document.querySelector('.main-nav li.active');
    const finalPage = finalCheck ? finalCheck.getAttribute('data-page') : null;
    if (finalPage !== 'news') {
      console.log('UI娓叉煋鍓嶆渶缁堟鏌ワ細褰撳墠涓嶅湪鐔婄尗鍔ㄦ€侀〉闈紝璺宠繃UI娓叉�?);
      return;
    }
    
    // 鍒濆娓叉煋棣栭〉鏂伴椈锛堝�?0鏉★�?
    renderPandaNews(contentContainer);
    
    // 鍒濆鍖栬嚜鍔ㄦ洿鏂板姛�?    if (typeof autoRefresh !== 'undefined' && autoRefresh.initAutoRefresh) {
      const newsPageContainer = document.querySelector('.news-page');
      if (newsPageContainer) {
        // 鍦ㄩ〉闈㈤《閮ㄦ坊鍔犲埛鏂版帶浠跺锟?        const refreshControlsContainer = document.createElement('div');
        refreshControlsContainer.className = 'refresh-controls';
        refreshControlsContainer.innerHTML = `
          <div class="refresh-status">
            <span>鏈€鍚庢洿鏂版椂�? </span>
            <span id="last-refresh-time">${new Date().toLocaleString('zh-CN', { hour12: false })}</span>
          </div>
          <div class="refresh-actions">
            <div class="auto-refresh-toggle">
              <input type="checkbox" id="auto-refresh-toggle-news">
              <label for="auto-refresh-toggle-news">鑷姩鏇存柊</label>
            </div>
            <select class="refresh-interval" id="refresh-interval-news">
              <option value="30000">30�?/option>
              <option value="60000" selected>1鍒嗛�?/option>
              <option value="300000">5鍒嗛�?/option>
              <option value="600000">10鍒嗛�?/option>
              <option value="1800000">30鍒嗛�?/option>
            </select>
          </div>
        `;
        
        // 灏嗗埛鏂版帶浠舵彃鍏ュ埌鏍囬涓嬫柟
        const newsTitle = newsPageContainer.querySelector('h2');
        if (newsTitle && newsTitle.nextSibling) {
          newsPageContainer.insertBefore(refreshControlsContainer, newsTitle.nextSibling);
        } else {
          newsPageContainer.insertBefore(refreshControlsContainer, newsPageContainer.firstChild.nextSibling);
        }
        
        // 鍒濆鍖栬嚜鍔ㄦ洿锟?        autoRefresh.initAutoRefresh(newsPageContainer, loadPandaNews, 60000);
        
        // 娣诲姞鍒锋柊闂撮殧閫夋嫨浜嬩�?
        const refreshIntervalSelect = document.getElementById('refresh-interval-news');
        if (refreshIntervalSelect) {
          refreshIntervalSelect.addEventListener('change', function() {
            const interval = parseInt(this.value);
            if (autoRefresh.toggleAutoRefresh) {
              // 濡傛灉鑷姩鏇存柊宸插惎鐢紝鍒欓噸鏂板惎鍔ㄤ互搴旂敤鏂伴棿�?              const autoRefreshToggle = document.getElementById('auto-refresh-toggle-news');
              if (autoRefreshToggle && autoRefreshToggle.checked) {
                autoRefresh.stopAutoRefresh();
                autoRefresh.startAutoRefresh(loadPandaNews, interval);
              }
            }
          });
        }
        
        // 娣诲姞鑷姩鏇存柊寮€鍏充簨�?        const autoRefreshToggle = document.getElementById('auto-refresh-toggle-news');
        if (autoRefreshToggle) {
          autoRefreshToggle.addEventListener('change', function() {
            const interval = parseInt(document.getElementById('refresh-interval-news').value);
            if (this.checked) {
              autoRefresh.startAutoRefresh(loadPandaNews, interval);
            } else {
              autoRefresh.stopAutoRefresh();
            }
          });
        }
      }
    }
  } catch (error) {
    console.error('鍔犺浇鐔婄尗鏂伴椈澶辫触:', error);
    contentContainer.innerHTML = `
      <div class="error-container">
        <p>鍔犺浇鐔婄尗鏂伴椈澶辫触锛岃绋嶅悗鍐嶈瘯锟?/p>
        <p class="error-details">${error.message}</p>
        <button id="retry-news" class="retry-button">閲嶈�?/button>
      </div>
    `;
    
    // 娣诲姞閲嶈瘯鎸夐挳鐐瑰嚮浜嬩�?
    const retryButton = document.getElementById('retry-news');
    if (retryButton) {
      retryButton.addEventListener('click', () => {
        loadPandaNews();
      });
    }
  }
}

// 娓叉煋鐔婄尗鏂伴椈鍐呭
function renderPandaNews(container) {
  // 鍒濆鍖栨柊闂籋TML
  let newsHtml = '';
  
  // 棣栨鍔犺浇鏃跺垱寤洪〉闈㈠�?  if (currentDisplayedNews === 0) {
    newsHtml = `
      <div class="page-container news-page">
        <h2>鍏ㄧ悆鐔婄尗鍔�?/h2>
        <p class="news-update-time">鏈€鍚庢洿鏂版椂�? ${new Date().toLocaleString('zh-CN', { hour12: false })}</p>
        <div class="news-container" id="news-container">
    `;
  } else {
    // 鑾峰彇鐜版湁鏂伴椈瀹瑰�?
    const newsContainer = document.getElementById('news-container');
    if (newsContainer) {
      newsContainer.innerHTML = '';
      container = newsContainer;
    }
    
    // 鏇存柊鏈€鍚庡埛鏂版椂锟?    const lastRefreshTime = document.getElementById('last-refresh-time');
    if (lastRefreshTime) {
      lastRefreshTime.textContent = new Date().toLocaleString('zh-CN', { hour12: false });
    }
    
    const newsUpdateTime = document.querySelector('.news-update-time');
    if (newsUpdateTime) {
      newsUpdateTime.textContent = `鏈€鍚庢洿鏂版椂�? ${new Date().toLocaleString('zh-CN', { hour12: false })}`;
    }
  }
  
  // 璁＄畻瑕佹樉绀虹殑鏂伴椈鑼冨洿
  const endIndex = Math.min(currentDisplayedNews + NEWS_PER_PAGE, allPandaNews.length, MAX_NEWS);
  
  // 娣诲姞鏂伴椈鍐呭�?
  for (let i = 0; i < endIndex; i++) {
    const news = allPandaNews[i];
    
    // 妫€鏌ユ柊闂绘暟鎹畬鏁达拷?    if (!news.title || !news.description) {
      console.warn('璺宠繃涓嶅畬鏁寸殑鏂伴椈鏁版�?', news);
      continue;
    }
    
    // 澶勭悊鍙兘缂哄け鐨勫浘�?    const imageUrl = news.image || './assets/panda_logo1.png';
    
    // 澶勭悊鍙兘缂哄け鐨勯摼�?    const newsUrl = news.url || '#';
    
    // 澶勭悊鍙兘缂哄け鐨勬潵婧恖ogo
    const sourceLogoUrl = news.sourceLogo || './assets/panda_logo1.png';
    
    // 鐢熸垚鏂伴椈HTML
    const newsItemHtml = `
      <article class="news-item">
        <div class="news-content">
          <div class="news-header">
            <h3>${news.title}</h3>
            <div class="source-logo-container">
              <img src="${sourceLogoUrl}" alt="${news.source || '鏈煡鏉ユ簮'}" class="source-logo" onerror="this.src='./assets/panda_logo1.png'">
            </div>
          </div>
          <div class="news-meta">
            <p class="news-date">${news.date || '鏃ユ湡鏈煡'}</p>
            <p class="news-source">鏉ユ�? ${news.source || '鏈煡鏉ユ簮'}</p>
          </div>
          <p class="news-description">${news.description}</p>
          <a href="${newsUrl}" class="read-more" target="_blank" data-url="${newsUrl}">闃呰鏇村</a>
        </div>
      </article>
    `;
    
    // 棣栨鍔犺浇鏃惰拷鍔犲埌HTML瀛楃涓诧紝鍚﹀垯鐩存帴娣诲姞鍒板�?    if (currentDisplayedNews === 0) {
      newsHtml += newsItemHtml;
    } else {
      container.innerHTML += newsItemHtml;
    }
  }
  
  // 鏇存柊褰撳墠鏄剧ず鐨勬柊闂绘暟锟?  currentDisplayedNews = endIndex;
  
  // 棣栨鍔犺浇鏃跺畬鎴怘TML骞舵洿鏂板唴�?  if (currentDisplayedNews <= NEWS_PER_PAGE) {
    // 娣诲姞鍔犺浇鏇村鎸夐挳鍜屽埛鏂版寜�?    newsHtml += `
        </div>
        <div class="news-actions">
          <button id="load-more-news" class="load-more-button" ${currentDisplayedNews >= Math.min(allPandaNews.length, MAX_NEWS) ? 'style="display:none;"' : ''}>鍔犺浇鏇村</button>
          <button id="refresh-news" class="refresh-button">
            <span class="refresh-icon"></span>
            鍒锋柊鏂伴椈
          </button>
        </div>
      </div>
    `;
    
    // 鏇存柊鍐呭
    container.innerHTML = newsHtml;
    
    // 娣诲姞鍔犺浇鏇村鎸夐挳鐐瑰嚮浜嬩欢
    const loadMoreButton = document.getElementById('load-more-news');
    if (loadMoreButton) {
      loadMoreButton.addEventListener('click', loadMoreNews);
    }
    
    // 娣诲姞鍒锋柊鎸夐挳鐐瑰嚮浜嬩�?
    const refreshButton = document.getElementById('refresh-news');
    if (refreshButton) {
      refreshButton.addEventListener('click', () => {
        // 娣诲姞鍒锋柊鍔ㄧ�?
        refreshButton.classList.add('refreshing');
        
        // 鎵ц鍒锋�?
        loadPandaNews().finally(() => {
          // 绉婚櫎鍒锋柊鍔ㄧ�?
          refreshButton.classList.remove('refreshing');
        });
      });
    }
  } else {
    // 鏇存柊鍔犺浇鏇村鎸夐挳鐘讹�?    const loadMoreButton = document.getElementById('load-more-news');
    if (loadMoreButton) {
      if (currentDisplayedNews >= Math.min(allPandaNews.length, MAX_NEWS)) {
        loadMoreButton.style.display = 'none';
      } else {
        loadMoreButton.style.display = 'block';
      }
    }
  }
  
  // 娣诲姞闃呰鏇村鐐瑰嚮浜嬩�?
  const readMoreLinks = document.querySelectorAll('.read-more');
  readMoreLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const url = this.getAttribute('data-url');
      if (!url || url === '#') {
        console.log('鏂伴椈閾炬帴鏃犳�?);
        return;
      }
      
      // 浣跨敤Electron鐨剆hell.openExternal鎵撳紑閾炬帴
      if (window.pandaAPI && window.pandaAPI.openExternalLink) {
        window.pandaAPI.openExternalLink(url)
          .then(result => {
            console.log('閾炬帴鎵撳紑缁撴�?', result);
          })
          .catch(error => {
            console.error('鎵撳紑閾炬帴鏃跺嚭锟?', error);
            // 澶辫触鏃跺洖閫€鍒版祻瑙堝櫒榛樿琛屼负
            window.open(url, '_blank');
          });
      } else {
        // 鍦ㄦ祻瑙堝櫒鐜涓洿鎺ユ墦寮€閾炬帴
        window.open(url, '_blank');
      }
    });
  });
}

// 鍔犺浇鏇村鏂伴�?
function loadMoreNews() {
  // 濡傛灉宸茬粡鏄剧ず浜嗗叏閮ㄦ柊闂绘垨杈惧埌鏈€澶ф樉绀烘暟閲忥紝鍒欎笉鍐嶅姞锟?  if (currentDisplayedNews >= Math.min(allPandaNews.length, MAX_NEWS)) {
    console.log('宸叉樉绀哄叏閮ㄥ彲鍔犺浇鐨勬柊锟?);
    return;
  }
  
  // 鑾峰彇鏂伴椈瀹瑰�?
  const newsContainer = document.getElementById('news-container');
  if (!newsContainer) {
    console.error('鏈壘鍒版柊闂诲锟?);
    return;
  }
  
  // 娓叉煋鏇村鏂伴�?
  renderPandaNews(newsContainer);
}

