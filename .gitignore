# 忽略node_modules目录
node_modules/

# 忽略日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 忽略编译输出
/dist
/build

# 忽略环境配置文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 忽略IDE和编辑器配置
.idea/
.vscode/
*.swp
*.swo

# 忽略操作系统生成的文件
.DS_Store
Thumbs.db

# 忽略包管理器锁文件（可选）
# package-lock.json
# yarn.lock

# 忽略临时文件
*.tmp
*.bak 